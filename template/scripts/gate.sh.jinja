{%- set langs = [] -%}
{%- for l in ['python', 'dotnet', 'typescript', 'rust'] if l in languages -%}{%- set _ = langs.append(l) -%}{%- endfor -%}
{%- set scan = 'python' in langs or 'dotnet' in langs or 'typescript' in langs -%}
#!/usr/bin/env bash
# The gate: every check a change must pass. Safe to re-run. The only gate
# script in the repo: CI, the hooks and agents all run this one, and
# the shell section fails while another gate script is tracked.
#   scripts/gate.sh                   the full checks of the sections that the
#                                     diff since the merge base touches (docs
#                                     alone run none); a path that maps to no
#                                     section runs every section, and so does
#                                     no merge base or no change. A rerun on a
#                                     clean tree that already passed exits at once
#   scripts/gate.sh --full            every section in full: run it before a PR;
#                                     CI runs it (a non-empty CI variable does
#                                     the same for the bare command)
#   scripts/gate.sh --fast            format, lint and secret scan on staged files
#                                     only; the pre-commit hook runs this (budget:
#                                     about 5 s)
#   scripts/gate.sh --size-baseline   write .gate-size-baseline: the tracked files
#                                     over the size cap of 5,000 tokens. --fast
#                                     allows a staged file over the cap, or over
#                                     its number in that list, asks for a refactor
#                                     issue, and lists the file at its new size
#   scripts/gate.sh [--full | --fast] --only SECTION ...
#                                     only those sections: {{ (langs + ['shell', 'local']) | join(', ') }}.
#                                     CI runs each in its own image.
# The repo's own checks go in scripts/gate.local.sh (the local section), which
# the repo owns. This script runs it with one argument, full or fast, from the
# repo root. A failing exit fails the gate. In fast mode, check staged files
# only and keep to the time budget.
# Each section writes its duration to .gate/<mode>.<section> (the gate keeps
# .gate out of git). A section over its budget fails the gate and names its
# slowest tests or steps. Budgets, in seconds: fast {{ gate_fast_budget }}, full {{ gate_full_budget if gate_full_budget else 'none' }}. A project
# raises one only with gate_budget_reason in its answers file.
# A full run prints one line: source lines added against test lines
# added since the merge base. It never fails on the ratio; see "Tests follow
# risk" in komputa-practice (rules/working-rules.md).
# Managed by project-standards: change the template, not this copy.
set -Eeuo pipefail
shopt -s inherit_errexit
trap 'printf "%s: line %d: %s exited %d\n" "${0##*/}" "$LINENO" "$BASH_COMMAND" "$?" >&2' ERR
die() {
  printf 'gate: %s\n' "$*" >&2
  exit 1
}

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
sections=({{ (langs + ['shell', 'local']) | join(' ') }})
usage() {
  printf 'usage: scripts/gate.sh [--full | --fast] [--only SECTION ...]\n       scripts/gate.sh --size-baseline\nsections: %s\n' "${sections[*]}" >&2
  exit 2
}
mode=full
explicit_full=
only=()
while (($# > 0)); do
  case "$1" in
    --full)
      [[ "$mode" == full ]] || usage
      explicit_full=1
      ;;
    --fast)
      [[ -z "$explicit_full" && "$mode" != size ]] || usage
      mode=fast
      ;;
    --size-baseline)
      [[ -z "$explicit_full" && "$mode" == full ]] || usage
      mode=size
      ;;
    --only)
      (($# > 1)) || usage
      only+=("$2")
      shift
      ;;
    --only=*) only+=("${1#--only=}") ;;
    # A bare section name works too, as in the first hand-adapted gates.
    {{ (langs + ['shell', 'local']) | join(' | ') }}) only+=("$1") ;;
    *) usage ;;
  esac
  shift
done
# want[SECTION] is set for each section this run includes; no --only means all.
chosen=${only[*]}
[[ -n "$chosen" ]] || only=("${sections[@]}")
declare -A want=()
for s in "${only[@]}"; do
  [[ " ${sections[*]} " == *" $s "* ]] || usage
  want[$s]=1
done

{%- if langs %}
# Each language's project folder, relative to the repo root.
{%- if 'python' in langs %}
python_dir='{{ python_dir }}'
{%- endif %}{% if 'dotnet' in langs %}
dotnet_dir='{{ dotnet_dir }}'
{%- endif %}{% if 'typescript' in langs %}
node_dir='{{ node_dir }}'
{%- endif %}{% if 'rust' in langs %}
rust_dir='{{ rust_dir }}'
{%- endif %}
{%- endif %}

# The merge base that the bare command compares with: GATE_BASE
# (default origin's default branch, else {{ default_branch }}). Empty when there is none, or
# in a fast run, which reads no diff.
base=
ref=${GATE_BASE-}
if [[ "$mode" != fast ]]; then
  if [[ -z "$ref" ]]; then
    # A full ref name: a tag or branch called "main" cannot shadow it.
    ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null) || ref=
    if [[ -z "$ref" ]]; then
      for ref in refs/remotes/origin/{{ default_branch }} refs/heads/{{ default_branch }}; do
        git rev-parse --verify --quiet "$ref^{commit}" >/dev/null && break
        ref=
      done
    fi
  fi
  base=$(git merge-base HEAD "$ref" 2>/dev/null) || base=
  ref=${ref#refs/heads/}
  ref=${ref#refs/remotes/}
fi

# Every branch is <kind>/<name>, so pull requests can be counted by kind: kinds feat fix docs refactor chore perf test
# ci prune, then lower-case words joined by -, the issue number first when there is one (fix/312-spec-drift). Bots name
# their own (dependabot/, renovate/). The branch: GATE_BRANCH, else a GitHub pull request's, else the one checked out.
# The default branch, main, master and a detached checkout (a CI merge preview) are not judged. It runs on each commit (--fast) and in CI
# wherever the shell section runs. komputa-practice holds the same rule in hooks/block-branch-name.sh.
if [[ "$mode" == fast || " ${only[*]} " == *" shell "* ]]; then
  branch=${GATE_BRANCH:-${GITHUB_HEAD_REF:-$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)}}
  kinds='feat|fix|docs|refactor|chore|perf|test|ci|prune'
  if [[ -n "$branch" && "$branch" != main && "$branch" != master && "$branch" != {{ default_branch }} ]] \
    && ! [[ "$branch" =~ ^(($kinds)/[a-z0-9]+([.-][a-z0-9]+)*|(dependabot|renovate)/.+)$ ]]; then
    printf "gate: branch '%s' is not <kind>/<name>. Use one of %s, then lower-case words joined by -, with the issue number first when there is one: fix/312-spec-drift. Rename it: git branch -m <kind>/<name>\n" \
      "$branch" "${kinds//|/ }" >&2
    exit 1
  fi
fi

# section_of PATH: the sections that a change to PATH can break, or "none" for
# a path no section reads (docs), or "?" for a path with no safe mapping.
section_of() {
  local p=$1 name=${1##*/}
{%- for l, d in [('python', 'python_dir'), ('dotnet', 'dotnet_dir'), ('typescript', 'node_dir'), ('rust', 'rust_dir')] if l in langs %}
  [[ "{{ '$' ~ d }}" == . || "$p" != "{{ '$' ~ d }}"/* ]] || {
    printf '%s\n' {{ l }}
    return
  }
{%- endfor %}
  # The gate runs every section: an edit to it can break any of them.
  [[ "$p" != scripts/gate.sh ]] || {
    printf '%s\n' "${sections[@]}"
    return
  }
{%- if scan %}
  # A lock file also changes what the dependency scan reads, and the shell section runs it.
  case "$name" in
    uv.lock | package-lock.json | packages.lock.json | .trivyignore.yaml) printf 'shell\n' ;;
    *) ;;
  esac
{%- endif %}
{%- if versioned %}
  # A version file also changes what the version check reads, and the shell section runs it.
  case "$name" in
    pyproject.toml | package.json | Cargo.toml | Directory.Build.props | *.csproj | VERSION | version-check.sh) printf 'shell\n' ;;
    *) ;;
  esac
{%- endif %}
  case "$name" in
{%- if 'python' in langs %}
    *.py | pyproject.toml | uv.lock | uv.toml | ruff.toml | pyrightconfig.json | pytest.toml)
      printf 'python\n'
      return
      ;;
{%- endif %}{% if 'dotnet' in langs %}
    *.cs | *.csproj | *.props | *.targets | *.razor | *.cshtml | *.resx | *.sln | *.slnx | global.json | packages.lock.json | nuget.config | dotnet-tools.json)
      printf 'dotnet\n'
      return
      ;;
{%- endif %}{% if 'typescript' in langs %}
    *.ts | *.tsx | *.js | *.jsx | *.mjs | *.cjs | package.json | package-lock.json | tsconfig*.json | .prettierrc* | .npmrc | eslint.config.* | vitest.config.*)
      printf 'typescript\n'
      return
      ;;
{%- endif %}{% if 'rust' in langs %}
    *.rs | Cargo.toml | Cargo.lock | deny.toml | rust-toolchain.toml | clippy.toml | rustfmt.toml | .rustfmt.toml)
      printf 'rust\n'
      return
      ;;
{%- endif %}
    *.sh | *.bash | .shellcheckrc)
      printf 'shell\n'
      return
      ;;
    gate | check | ci | quality | gate.* | check.* | ci.* | quality.*)
      printf 'shell\n'
      return
      ;;
    *.md | LICENSE*)
      printf 'none\n'
      return
      ;;
  esac
  case "$p" in
    .githooks/* | bin/* | scripts/*) printf 'shell\n' ;;
    docs/*{% if not adr_dir.startswith('docs/') %} | {{ adr_dir }}/*{% endif %}) printf 'none\n' ;;
    *) printf '?\n' ;;
  esac
}

# The bare command checks the sections that the diff touches, in full. CI with
# --only does the same for the sections it names: a CI build of a pull request
# runs on the merge preview, whose first parent is the target branch. The shell
# and local sections always run in CI: they hold the secret scan. A run with
# --full or --fast checks what it names.
scope=
scope_base=$base
scope_ref=$ref
if [[ -z "$scope_base" && -n "$chosen" && -n "${CI-}" ]] \
  && [[ "$(git rev-list --parents -n 1 HEAD 2>/dev/null | wc -w)" == 3 ]]; then
  scope_base=$(git rev-parse HEAD^1)
  scope_ref=HEAD^1
fi
if [[ "$mode" == full && -z "$explicit_full" ]] \
  && { [[ -z "$chosen" && -z "${CI-}" ]] || [[ -n "$chosen" && -n "${CI-}" ]]; }; then
  if [[ -z "$scope_base" ]]; then
    printf 'gate: scope: every section, because there is no merge base with %s (set GATE_BASE)\n' "$scope_ref"
  else
    paths=$({
      git diff --name-only --no-renames "$scope_base" -- ':/'
      git ls-files --others --exclude-standard --full-name -- ':/'
    } | sort -u)
    declare -A hit=()
    unmapped=
    n=0
    while IFS= read -r p; do
      [[ -n "$p" ]] || continue
      n=$((n + 1))
      for m in $(section_of "$p"); do
        case "$m" in
          none) ;;
          '?') [[ -n "$unmapped" ]] || unmapped=$p ;;
          *) hit[$m]=1 ;;
        esac
      done
    done <<<"$paths"
    if ((n == 0)); then
      printf 'gate: scope: every section, because nothing changed since %s\n' "$scope_ref"
    elif [[ -n "$unmapped" ]]; then
      printf 'gate: scope: every section, because no section covers %s\n' "$unmapped"
    elif [[ -z "${hit[*]-}" && -z "${CI-}" ]]; then
      printf 'gate: scope: no section; %d changed path(s) since %s are docs. Run scripts/gate.sh --full to check everything\n' "$n" "$scope_ref"
      exit 0
    else
      # The repo's own checks run beside any section: they may read any file.
      hit[local]=1
      # In CI the shell section holds the secret scan, so it always runs.
      [[ -z "${CI-}" ]] || hit[shell]=1
      want=()
      for s in "${only[@]}"; do
        [[ -z "${hit[$s]-}" ]] || {
          want[$s]=1
          scope+="${scope:+ }$s"
        }
      done
      if [[ -z "$scope" ]]; then
        printf 'gate: scope: no section; %d changed path(s) since %s are docs or outside the sections named. Run scripts/gate.sh --full to check everything\n' "$n" "$scope_ref"
        exit 0
      fi
      printf 'gate: scope: %s (%d changed path(s) since %s). Run scripts/gate.sh --full to check everything\n' "$scope" "$n" "$scope_ref"
    fi
  fi
fi

# tree_key: the clean tree and the sections this run checks, or nothing when
# the working tree has changes (untracked files too: ruff and pytest read them).
tree_key() {
  local tree s key
  [[ -z "$(git status --porcelain)" ]] || return 0
  tree=$(git rev-parse -q --verify 'HEAD^{tree}') || return 0
  key=$tree
  for s in "${sections[@]}"; do
    [[ -z "${want[$s]-}" ]] || key+=" $s"
  done
  printf '%s\n' "$key"
}

# A full run on a clean tree that already passed these sections has nothing new
# to check. CI checks out fresh, so it never skips. Without git (a CI image may
# have none) there is no tree to key on, so the gate runs in full.
checked=
if [[ "$mode" == full ]] && passed=$(git rev-parse --git-path gate-passed 2>/dev/null); then
  checked=$(tree_key)
  if [[ -n "$checked" && -f "$passed" && "$(<"$passed")" == "$checked" ]]; then
    printf 'gate: tree %s already passed %s; nothing changed. Delete %s to run it again\n' \
      "${checked%% *}" "${checked#* }" "$passed"
    exit 0
  fi
fi

# Tools not in a lock file run through uvx with the seven-day cooldown.
uvx_tool() {
  uvx --quiet --exclude-newer "7 days" "$@"
}

# Section budgets, in seconds; 0 means none. A section that runs over its
# budget fails the gate once it has finished (the budget is not a timeout).
budget_fast={{ gate_fast_budget }}
budget_full={{ gate_full_budget }}
gate_dir=$root/.gate
section=
section_start=0
steps=

# gate_ignore DIR: keep everything in DIR out of git.
gate_ignore() {
  mkdir -p "$1"
  [[ "$(cat "$1/.gitignore" 2>/dev/null)" == '*' ]] || printf '*\n' >"$1/.gitignore"
}

# section_begin NAME: start the clock for one section. .gate holds its own
# .gitignore, so no repo needs a line in its own .gitignore for it.
section_begin() {
  section=$1
  section_start=$SECONDS
  mkdir -p "$gate_dir"
  gate_ignore "$gate_dir"
  steps=$gate_dir/$mode.$section.steps
  : >"$steps"
}

# timed LABEL COMMAND...: run COMMAND and note how long it took, so a section
# over budget can name its slowest steps. Returns COMMAND's status.
timed() {
  local label=$1 t=$SECONDS rc=0
  shift
  "$@" || rc=$?
  printf '%d\t%s\n' "$((SECONDS - t))" "$label" >>"$steps"
  return "$rc"
}

# section_end: record the section's duration in .gate/<mode>.<section> and fail
# when it is over its budget.
section_end() {
  local took=$((SECONDS - section_start)) limit=0
  printf '%d\n' "$took" >"$gate_dir/$mode.$section"
  case "$mode" in
    fast) limit=$budget_fast ;;
    full) limit=$budget_full ;;
  esac
  if ((limit > 0 && took > limit)); then
    printf 'gate: the %s section took %d s; its %s budget is %d s\n' "$section" "$took" "$mode" "$limit" >&2
    if [[ "$section" == python ]]; then
      printf 'gate: the slowest tests are in the "slowest durations" list that pytest printed above\n' >&2
    elif [[ -s "$steps" ]]; then
      printf 'gate: its slowest steps:\n' >&2
      sort -rn "$steps" | head -n 5 | sed 's/^/  /' >&2
    else
      printf 'gate: no per-test times for this section; run its test command with the runner'"'"'s own timing option\n' >&2
    fi
    printf 'gate: make it faster, or raise the budget with gate_budget_reason in .copier-answers.yml\n' >&2
    exit 1
  fi
}

# staged <pattern...>: staged files (added, copied, modified) matching the
# globs, under the current folder and relative to it.
staged() {
  git diff --cached --name-only --relative --diff-filter=ACM -- "$@"
}

# The tools read the file on disk, not the staged content. A staged file with
# more changes on disk would be checked as it is on disk, and the commit would
# take the other content. Refuse it: the gate must not answer for a file that
# it did not read.
if [[ "$mode" == fast ]]; then
  partly=$(comm -12 <(git diff --cached --name-only --diff-filter=ACM | sort) <(git diff --name-only | sort))
  if [[ -n "$partly" ]]; then
    printf 'gate: staged, with more changes on disk: %s\n' "${partly//$'\n'/, }" >&2
    die "the gate reads the file on disk, so it cannot check what this commit takes. Stage the rest (git add), or set it aside (git stash push --keep-index), then commit again"
  fi
fi

# The file size cap. A large file costs tokens on every later call of an agent
# that read it, so a staged file over $size_cap tokens (bytes / 4) needs a
# refactor issue on the forge, at high priority. The gate allows the commit and
# asks for the issue. .gate-size-baseline lists the files over the cap as
# "<tokens> <path>" lines, so the gate asks once: again only when a listed file
# grows. A file leaves the list when it is under the cap.
# scripts/gate.sh --size-baseline writes the list from the tracked files.
size_cap=5000
size_list=.gate-size-baseline

# size_counted PATH: true for a file that the cap covers: source code only, by
# its extension, or a script with no extension whose first line is a #! line.
# Documents (HTML, Markdown, CSS, SVG, text) are content, not modules to split,
# so they never count. Lock files, generated code, test data, the files that
# the template manages and binary files are not covered either.
size_counted() {
  case "$1" in
    *.lock | *-lock.json | *-lock.yaml | *packages.lock.json | *.min.js | *.min.css | *.map | *.snap | *.g.cs | *.generated.* | *.Designer.cs) return 1 ;;
    fixtures/* | */fixtures/* | __fixtures__/* | */__fixtures__/* | testdata/* | */testdata/* | */__snapshots__/*) return 1 ;;
    scripts/gate.sh | scripts/update-deps.sh | .secrets.baseline | .gate-size-baseline) return 1 ;;
    *.py | *.pyi | *.ts | *.tsx | *.mts | *.cts | *.js | *.jsx | *.mjs | *.cjs | *.vue | *.svelte) ;;
    *.cs | *.fs | *.razor | *.cshtml | *.rs | *.go | *.java | *.kt | *.swift | *.sql) ;;
    *.sh | *.bash | *.ps1 | *.psm1) ;;
    *)
      # Any other extension is not code. No extension: code when it starts #!.
      [[ ${1##*/} != *.* ]] || return 1
      head -c 2 -- "$1" 2>/dev/null | grep -q '^#!' || return 1
      ;;
  esac
  # grep -I finds no line in a binary file, or in an empty one.
  grep -Iq . -- "$1"
}

# size_tokens PATH: its size in tokens, rounded up.
size_tokens() {
  local bytes
  bytes=$(wc -c <"$1")
  printf '%d\n' $(((bytes + 3) / 4))
}

if [[ "$mode" == size ]]; then
  found=
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    # shellcheck disable=SC2310 # the status is the answer.
    size_counted "$f" || continue
    tokens=$(size_tokens "$f")
    ((tokens <= size_cap)) || found+="$tokens $f"$'\n'
  done < <(git ls-files)
  printf '%s' "$found" >"$size_list"
  printf 'gate: wrote %s: %d file(s) over %d tokens\n' "$size_list" "$(grep -c . "$size_list" || true)" "$size_cap"
  exit 0
fi

if [[ "$mode" == fast ]]; then
  declare -A listed=()
  if [[ -f "$size_list" ]]; then
    while read -r tokens f; do
      [[ ! "$tokens" =~ ^[0-9]+$ || -z "$f" ]] || listed[$f]=$tokens
    done <"$size_list"
  fi
  over=0
  changed=0
  while IFS= read -r f; do
    [[ -n "$f" && -f "$f" ]] || continue
    # shellcheck disable=SC2310 # the status is the answer.
    size_counted "$f" || continue
    tokens=$(size_tokens "$f")
    limit=${listed[$f]:-$size_cap}
    if ((tokens > limit)); then
      printf 'gate: %s is %d tokens (bytes / 4); its limit is %d\n' "$f" "$tokens" "$limit" >&2
      over=$((over + 1))
      listed[$f]=$tokens
      changed=1
    elif [[ -n "${listed[$f]-}" ]] && ((tokens < limit)); then
      # 0 takes a file that is now under the cap off the list.
      listed[$f]=$((tokens > size_cap ? tokens : 0))
      changed=1
    fi
  done < <(staged)
  if ((over > 0)); then
    printf 'gate: allowed. Open a refactor issue on the forge at high priority for each file above, unless one is open: split it, one module for each concern, and tests in their own file (house-architecture, large files)\n' >&2
  fi
  if ((changed)); then
    for f in "${!listed[@]}"; do
      ((listed[$f] == 0)) || printf '%d %s\n' "${listed[$f]}" "$f"
    done | sort -k2 >"$size_list"
    git add -- "$size_list"
    printf 'gate: staged the updated %s\n' "$size_list"
  fi
fi

# The secret scan. .secrets.baseline holds the findings already reviewed. A
# fast run scans the staged files and stages the baseline when it only moved
# line numbers. A full run (CI) scans every file that the branch changed since
# the merge base, or every tracked file when there is no merge base, so that a
# key committed with --no-verify still fails. It works on a copy of the
# baseline and leaves the tree as it found it. It runs in the shell section.
# secret_scan FILE...: fail the gate on a possible secret.
secret_scan() {
  # The baseline holds the findings already reviewed, so it is never scanned: a
  # change to it would fail on the very lines it lists. Every list passes here.
  local f args=()
  for f in "$@"; do [[ "$f" == .secrets.baseline ]] || args+=("$f"); done
  set -- "${args[@]}"
  (($# > 0)) || return 0
  local scan=(uvx --quiet --exclude-newer "7 days" --from detect-secrets detect-secrets-hook)
  local base_file=.secrets.baseline before
  # A OneDev reference such as @secret:NAME@ names a job secret; it is not one.
  # The baseline's line filter holds this pattern and any the repo adds. Pass
  # it only without a baseline: --exclude-lines replaces that filter.
  local secret_refs=(--exclude-lines '@secret:[A-Za-z0-9_.-]+@')
  if [[ -f .secrets.baseline ]]; then
    if [[ "$mode" != fast ]]; then
      mkdir -p "$gate_dir"
      base_file=$gate_dir/secrets.baseline
      cp .secrets.baseline "$base_file"
    fi
    before=$(git hash-object "$base_file")
    if ! "${scan[@]}" --baseline "$base_file" "$@"; then
      # The hook fails once when it only moves known findings' line numbers
      # in the baseline. Rewrite and scan again; a new finding fails twice.
      # Compare the content, not git diff: the baseline may not be tracked yet.
      if [[ "$(git hash-object "$base_file")" != "$before" ]] \
        && { [[ "$mode" != fast ]] || git add .secrets.baseline; } \
        && "${scan[@]}" --baseline "$base_file" "$@"; then
        [[ "$mode" != fast ]] || printf 'gate: staged the updated .secrets.baseline (line numbers moved)\n'
      else
        die "possible secret in a file; read it with {{ vault_command }} instead"
      fi
    fi
  else
    printf 'gate: no .secrets.baseline, so no finding counts as reviewed. Create it:\n' >&2
    printf "  uvx --exclude-newer '7 days' --from detect-secrets detect-secrets scan --exclude-lines '@secret:[A-Za-z0-9_.-]+@' > .secrets.baseline\n" >&2
    "${scan[@]}" "${secret_refs[@]}" "$@" || die "possible secret in a file; read it with {{ vault_command }} instead"
  fi
}

{%- if scan %}

# The dependency scan (full run only). Trivy reads every uv.lock,
# package-lock.json and packages.lock.json that git tracks, for known
# vulnerabilities, and fails on HIGH and CRITICAL ones that have a fix. Rust keeps
# cargo deny. The fast run skips it: the Trivy binary and its vulnerability
# database take longer than the pre-commit budget, and CI scans the same files.
# Trivy downloads its database from a registry on each run (cached in .gate/trivy),
# so offline the scan fails: with an earlier download in .gate/trivy, set
# TRIVY_SKIP_DB_UPDATE=true to scan with that. The binary is pinned in
# scripts/trivy.pin. Accept a finding on record in .trivyignore.yaml: each entry
# needs an id and a statement that gives the reason.
trivy_scan() {
  local locks=() f ignore=.trivyignore.yaml
  while IFS= read -r f; do
    [[ -f "$f" ]] && locks+=("$f")
  done < <(git ls-files -- 'uv.lock' '*/uv.lock' 'package-lock.json' '*/package-lock.json' 'packages.lock.json' '*/packages.lock.json')
  [[ -n "${locks[*]}" ]] || return 0
  if [[ -f "$ignore" ]]; then
    awk '
      function check() { if (open && !has) { printf "%s: line %d: the entry has no statement (the reason)\n", FILENAME, open; bad = 1 } }
      /^[[:space:]]*-[[:space:]]+id:/ { check(); open = NR; has = 0 }
      /^[[:space:]]+statement:[[:space:]]*[^[:space:]]/ { has = 1 }
      END { check(); exit bad }
    ' "$ignore" >&2 || die "$ignore: give each entry a statement that says why the finding is accepted"
  fi
  local trivy copy=$gate_dir/trivy-scan
  trivy=$(scripts/install-trivy.sh) || die "no Trivy binary; see above"
  rm -rf "$copy"
  mkdir -p "$copy"
  for f in "${locks[@]}"; do
    mkdir -p "$copy/$(dirname -- "$f")"
    cp -- "$f" "$copy/$f"
  done
  local args=(fs --scanners vuln --severity "HIGH,CRITICAL" --ignore-unfixed --exit-code 1 --no-progress
    --skip-version-check --disable-telemetry --cache-dir "$gate_dir/trivy")
  [[ ! -f "$ignore" ]] || args+=(--ignorefile "$root/$ignore")
  # Trivy exits 1 for a finding and for an error alike; its own text names which.
  timeout 600 "$trivy" "${args[@]}" "$copy" \
    || die "dependency scan failed: a lock file has a HIGH or CRITICAL vulnerability with a fix (named above), or Trivy could not get its database. Upgrade the package, or accept the finding with a reason in $ignore"
}
{%- endif %}

if [[ "$mode" == fast ]]; then
  files=$(staged)
  if [[ -n "$files" ]]; then
    mapfile -t list <<<"$files"
    secret_scan "${list[@]}"
  fi
fi
{%- if 'python' in langs %}

# Python, in $python_dir. Dev tools sit in an extra or a group: install both.
if [[ -n "${want[python]-}" ]]; then
  section_begin python
  cd "$root/$python_dir"
  run=(uv run --locked --all-extras --all-groups)
  # A run of the whole suite uses every core when the repo locks pytest-xdist.
  # Cap it with --maxprocesses in pytest.toml's addopts.
  workers=()
  if grep -qx 'name = "pytest-xdist"' uv.lock; then
    workers=(-n auto)
  fi
  case "$mode" in
    fast)
      py=$(staged '*.py')
      if [[ -n "$py" ]]; then
        mapfile -t list <<<"$py"
        # --force-exclude, or ruff checks a named file that ruff.toml excludes.
        "${run[@]}" ruff format --check --force-exclude "${list[@]}"
        "${run[@]}" ruff check --force-exclude "${list[@]}"
      fi
      ;;
    full)
      "${run[@]}" ruff format --check .
      "${run[@]}" ruff check .
      "${run[@]}" pyright --warnings
      [[ ! -f .importlinter ]] || "${run[@]}" lint-imports
      rc=0
      "${run[@]}" pytest --durations=5 --durations-min=0.5 "${workers[@]}" || rc=$?
      # 5: pytest collected no tests, as in a repo that has none yet.
      ((rc != 5)) || printf 'gate: python: pytest collected no tests\n'
      ((rc == 0 || rc == 5)) || exit "$rc"
      ;;
  esac
  cd "$root"
  section_end
fi
{%- endif %}{% if 'dotnet' in langs %}

# .NET, in $dotnet_dir (the folder with the solution).
if [[ -n "${want[dotnet]-}" ]]; then
  section_begin dotnet
  cd "$root/$dotnet_dir"
  case "$mode" in
    fast)
      cs=$(staged '*.cs')
      if [[ -n "$cs" ]]; then
        mapfile -t list <<<"$cs"
        # --folder: whitespace needs no restore, so it fits the time budget.
        dotnet format whitespace . --folder --verify-no-changes --include "${list[@]}"
      fi
      ;;
    full)
      dotnet tool restore
      dotnet restore{% if dotnet_lock_files %} --locked-mode{% endif %}
      # The build enforces the analyzers and code style (Directory.Build.props), so format only checks whitespace.
      dotnet format whitespace --verify-no-changes --no-restore
      dotnet build --no-restore
      timed 'dotnet test' dotnet test --no-build
      ;;
  esac
  cd "$root"
  section_end
fi
{%- endif %}{% if 'typescript' in langs %}

# TypeScript, in $node_dir (the folder with package.json). Run npm ci there first.
if [[ -n "${want[typescript]-}" ]]; then
  section_begin typescript
  cd "$root/$node_dir"
  case "$mode" in
    fast)
      ts=$(staged '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs')
      if [[ -n "$ts" ]]; then
        mapfile -t list <<<"$ts"
        npx --no-install prettier --check "${list[@]}"
        npx --no-install eslint --max-warnings 0 "${list[@]}"
      fi
      ;;
    full)
      [[ -d node_modules ]] || die "$node_dir/node_modules is missing; run npm ci there first"
      npx --no-install tsc --noEmit
      npx --no-install eslint --max-warnings 0 .
      npx --no-install prettier --check .
      timed vitest npx --no-install vitest run
      ;;
  esac
  cd "$root"
  section_end
fi
{%- endif %}{% if 'rust' in langs %}

# Rust, in $rust_dir (the folder with Cargo.toml). rust-toolchain.toml there
# pins the toolchain, so a RUSTUP_TOOLCHAIN from the caller must not override it.
if [[ -n "${want[rust]-}" ]]; then
  section_begin rust
  cd "$root/$rust_dir"
  unset RUSTUP_TOOLCHAIN
  case "$mode" in
    fast)
      rs=$(staged '*.rs')
      if [[ -n "$rs" ]]; then
        mapfile -t list <<<"$rs"
        # rustfmt alone takes edition 2015; Cargo.toml names the real one.
        edition=
        [[ ! -f Cargo.toml ]] || edition=$(sed -n '/^edition *= *"[0-9]*"/{s/^edition *= *"\([0-9]*\)".*/\1/p;q}' Cargo.toml)
        bad=
        for f in "${list[@]}"; do
          # On stdin rustfmt formats this file only, not the modules it declares.
          cmp -s "$f" <(rustfmt --edition "${edition:-2021}" --emit stdout <"$f" 2>/dev/null) || bad+="  $f"$'\n'
        done
        if [[ -n "$bad" ]]; then
          printf 'gate: rustfmt would change these staged files; run cargo fmt --all and stage them:\n%s' "$bad" >&2
          exit 1
        fi
      fi
      ;;
    full)
      cargo fmt --all --check
      timed clippy cargo clippy --locked --all-targets -- -D warnings
      timed 'cargo deny' cargo deny --locked check
      timed 'cargo test' cargo test --locked
      ;;
  esac
  cd "$root"
  section_end
fi
{%- endif %}

# Shell scripts, in every repo: *.sh and *.bash, plus files without an
# extension in .githooks/, bin/ and scripts/ whose shebang names a shell. A
# Python script in bin/ is not shell. The section also fails while a second
# gate script is tracked.
if [[ -n "${want[shell]-}" ]]; then
  section_begin shell
  if [[ "$mode" == full ]]; then
    # Every file the branch changed, at the tip and in each of its commits: a
    # key added and removed again is still in the history that a merge keeps.
    # Without a merge base: every tracked file. -z keeps odd names whole.
    if [[ -n "$base" ]]; then
      mapfile -d '' -t list < <(git diff -z --name-only --no-renames --diff-filter=d "$base" HEAD --)
    else
      mapfile -d '' -t list < <(git ls-files -z)
    fi
    present=()
    for f in "${list[@]}"; do
      if [[ -f "$f" && "$f" != .secrets.baseline ]]; then present+=("$f"); fi
    done
    if [[ -n "${present[*]}" ]]; then
      timed secret-scan secret_scan "${present[@]}"
    fi
    if [[ -n "$base" ]]; then
      hist=$gate_dir/history
      rm -rf "$hist"
      seen=" "
      while IFS= read -r c; do
        mapfile -d '' -t list < <(git diff-tree -r -z --no-commit-id --name-only --diff-filter=d "$c")
        have=()
        for f in "${list[@]}"; do
          [[ "$f" != .secrets.baseline ]] || continue
          blob=$(git rev-parse "$c:$f")
          [[ "$seen" != *" $blob "* ]] || continue
          seen+="$blob "
          mkdir -p "$hist/$(dirname -- "$f")"
          git cat-file blob "$blob" >"$hist/$f"
          have+=("$f")
        done
        if [[ -n "${have[*]}" ]]; then
          [[ ! -f .secrets.baseline ]] || cp .secrets.baseline "$hist/.secrets.baseline"
          (cd "$hist" && timed secret-scan-history secret_scan "${have[@]}")
          rm -rf "$hist"
        fi
      done < <(git rev-list "$base..HEAD")
    fi
  fi
{%- if scan %}
  [[ "$mode" != full ]] || timed trivy trivy_scan
{%- endif %}
  # Vendored or retired folders, kept as they are (the shell_exclude answer):
  # no lint, and a gate script there is not a second gate.
  skip=({% for d in shell_exclude %}':!{{ d }}/'{% if not loop.last %} {% endif %}{% endfor %})
  shebang='^#!.*[/ ](ba|da|k|z)?sh([[:space:]]|$)'

  # One gate: a repo's old gate script folds into scripts/gate.local.sh. A
  # gate script under a fixtures, __fixtures__, tests, test, spec or testdata folder is test data, and
  # scripts/gate.ps1 may be the PowerShell twin of scripts/gate.sh. First, so
  # a lint error in an old gate does not hide this message.
  old_gate='^(gate|check|ci|quality)(\.(sh|bash|ps1))?$'
  not_tests=(':(exclude,glob)**/fixtures/**' ':(exclude,glob)**/__fixtures__/**' ':(exclude,glob)**/tests/**'
    ':(exclude,glob)**/test/**' ':(exclude,glob)**/spec/**' ':(exclude,glob)**/testdata/**')
  case "$mode" in
    # R too: a staged rename of an old gate is still one.
    fast) candidates=$(git diff --cached --name-only --relative --diff-filter=ACMR -- "${skip[@]}" "${not_tests[@]}") ;;
    full) candidates=$(git ls-files -- "${skip[@]}" "${not_tests[@]}") ;;
  esac
  hits=0
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    # Fold case on the file name only: Gate.ps1 and CI.sh count, and
    # Scripts/Gate.ps1 is not the twin.
    name=${f##*/}
    name=${name,,}
    [[ "$name" =~ $old_gate && "$f" != scripts/gate.sh && "$f" != scripts/gate.ps1 ]] || continue
    # A bare name such as docs/ci is a script only when its shebang names a shell.
    [[ "$name" == *.* ]] || head -n 1 -- "$f" | grep -Eq "$shebang" || continue
    # The whole path, so app/gate.sh does not match a call to scripts/gate.sh.
    path=$(printf '%s' "$f" | sed 's/[][\\.*^$+?(){}|]/\\&/g')
    callers=$(git grep -l -E -e "(^|[^A-Za-z0-9_./-])(\./)?$path([^A-Za-z0-9_./-]|$)" \
      -- .onedev-buildspec.yml '.github/workflows/*' .gitlab-ci.yml '.githooks/*' || true)
    printf 'gate: %s is a second gate script; fold its checks into scripts/gate.local.sh and remove it%s\n' \
      "$f" "${callers:+ (called from: ${callers//$'\n'/, })}" >&2
    hits=$((hits + 1))
  done <<<"$candidates"
  ((hits == 0)) || exit 1

  # The CI pattern every project keeps: Deslop on each pull request, the Deslop
  # nightly and the weekly dependency refresh, at this project's schedule_slot
  # ({{ schedule_slot }}), so that projects on one server do not run at once. The
  # build spec belongs to the repo after the first copy, so this checks it has
  # not drifted. Full mode only: CI runs it.
  if [[ "$mode" == full ]]; then
{%- if forge == "onedev" %}
    spec=.onedev-buildspec.yml
    # job_block NAME: the lines of the job NAME, up to the next job.
    job_block() { awk -v want="- name: $1" '/^- name: /{on = ($0 == want)} on' "$spec"; }
    # pr_jobs: the lines of every job that pull requests run (a PullRequestUpdateTrigger),
    # whatever its name: a project may split CI into jobs of its own.
    pr_jobs() { awk '/^- name: /{if (blk ~ /PullRequestUpdateTrigger/) printf "%s", blk; blk = ""} {blk = blk $0 "\n"} END{if (blk ~ /PullRequestUpdateTrigger/) printf "%s", blk}' "$spec"; }
    pattern=(
      'Duplicate code|PullRequestUpdateTrigger'
      'Duplicate code|scripts/deslop-decisions\.sh'
      'Deslop nightly|cronExpression: 0 {{ nightly_minute }} {{ nightly_hour }} \* \* \?'
      'Secret scan nightly|cronExpression: 0 {{ nightly_minute }} {{ nightly_hour }} \* \* \?'
      'Secret scan nightly|scripts/trufflehog-scan\.sh'
{%- if versioned %}
      'Tag release|scripts/tag-release\.sh'
{%- endif %}
      "Update dependencies|cronExpression: 0 {{ weekly_minute }} {{ weekly_hour }} \? \* {{ ['MON','TUE','WED','THU','FRI','SAT','SUN'][weekly_day] }}"
      # Later fixes depend on these gate-step lines. A template PR that adds a
      # scripts/gate.sh call to the spec adds its pattern here (a test holds it).
      'PR|git fetch --quiet origin'
{%- set sections = [] -%}
{%- for l in ['python', 'dotnet', 'typescript', 'rust'] if l in languages -%}{%- set _ = sections.append(l) -%}{%- endfor -%}
{#- One pattern for each gate step, so that dropping CI=true or $FULL from one step fails. -#}
{%- if 'dotnet' in languages or 'typescript' in languages or 'rust' in languages -%}
{%- set gate_calls = [] -%}
{%- for l in sections + ['shell --only local'] -%}{%- set _ = gate_calls.append('CI=true scripts/gate\\.sh --only ' ~ l ~ ' [$]FULL') -%}{%- endfor -%}
{%- else -%}
{%- set gate_calls = ['scripts/gate\\.sh --full'] -%}
{%- endif %}
{%- for call in gate_calls %}
      'PR|{{ call }}'
{%- endfor %}
{%- if trust_green_ci %}
      'CI on main|Trust a green CI build'
      'CI on main|git fetch --quiet origin'
{%- for call in gate_calls %}
      'CI on main|{{ call }}'
{%- endfor %}
{%- endif %}
    )
    for want in "${pattern[@]}"; do
      # grep reads all of the block (no -q): an early exit kills awk with SIGPIPE, and pipefail then reports a match as a miss.
      ok=0
      if [[ ! -f "$spec" ]]; then
        job="the job \"${want%%|*}\""
      elif [[ "${want%%|*}" == PR ]]; then
        job='a job that pull requests run'
        # shellcheck disable=SC2310 # the status is the answer.
        if pr_jobs | grep -E -- "${want#*|}" >/dev/null; then ok=1; fi
      else
        job="the job \"${want%%|*}\""
        # shellcheck disable=SC2310 # the status is the answer.
        if job_block "${want%%|*}" | grep -E -- "${want#*|}" >/dev/null; then ok=1; fi
      fi
      if ((! ok)); then
        printf 'gate: %s needs %s with %s, as the template seeds it (schedule_slot {{ schedule_slot }})\n' \
          "$spec" "$job" "${want#*|}" >&2
        hits=$((hits + 1))
      fi
    done
{%- else %}
    flows=.github/workflows
    pattern=(
      "$flows/gate.yml|scripts/deslop-pr\.sh"
      "$flows/gate.yml|scripts/deslop-decisions\.sh"
      "$flows/gate.yml|fetch-depth: 0"
      "$flows/gate.yml|scripts/gate\.sh --(full|only shell)"
      "$flows/deslop-nightly.yml|cron: '{{ nightly_minute }} {{ nightly_hour }} \* \* \*'"
      "$flows/trufflehog-nightly.yml|cron: '{{ nightly_minute }} {{ nightly_hour }} \* \* \*'"
{%- if versioned %}
      "$flows/tag-release.yml|scripts/tag-release\.sh"
{%- endif %}
      "$flows/update-deps.yml|cron: '{{ weekly_minute }} {{ weekly_hour }} \* \* {{ (weekly_day + 1) % 7 }}'"
    )
    for want in "${pattern[@]}"; do
      if ! grep -Eq -- "${want#*|}" "${want%%|*}" 2>/dev/null; then
        printf 'gate: %s needs %s, as the template seeds it (schedule_slot {{ schedule_slot }})\n' "${want%%|*}" "${want#*|}" >&2
        hits=$((hits + 1))
      fi
    done
{%- endif %}
{%- if pstack_plugin and kind in ["app", "cli"] %}
    # pstack, scoped by tier: an app or a command-line tool enables the plugin and
    # starts each session with .claude/pstack-mandate.md (the template seeds both).
    for want in '"{{ pstack_plugin }}": true' 'pstack-mandate.md'; do
      if ! grep -qF -- "$want" .claude/settings.json 2>/dev/null; then
        printf 'gate: .claude/settings.json needs %s, as the template seeds it (pstack for tier 2 and 3 work)\n' "$want" >&2
        hits=$((hits + 1))
      fi
    done
{%- endif %}
{%- if versioned %}
    # One semver version with one source (house-architecture, versioning).
    # shellcheck disable=SC2310 # the status is the answer.
    scripts/version-check.sh "${skip[@]}" || hits=$((hits + 1))
{%- endif %}
    ((hits == 0)) || exit 1
  fi

  shell_files=('*.sh' '*.bash' '.githooks/*' 'bin/*' 'scripts/*' "${skip[@]}")
  case "$mode" in
    fast) candidates=$(staged "${shell_files[@]}") ;;
    full) candidates=$(git ls-files -- "${shell_files[@]}") ;;
  esac
  list=()
  n=0
  while IFS= read -r f; do
    [[ -n "$f" && -f "$f" ]] || continue
    case "${f##*/}" in
      *.sh | *.bash) list+=("$f") n=$((n + 1)) ;;
      *.*) ;;
      *) if head -n 1 -- "$f" | grep -Eq "$shebang"; then list+=("$f") n=$((n + 1)); fi ;;
    esac
  done <<<"$candidates"
  if ((n > 0)); then
    timed shellcheck uvx_tool --from shellcheck-py shellcheck "${list[@]}"
    # --apply-ignore: honour .editorconfig `ignore = true` too.
    timed shfmt uvx_tool --from shfmt-py shfmt --apply-ignore -d "${list[@]}"
  fi
  section_end
fi

# The repo's own checks, if it has any: scripts/gate.local.sh full|fast.
if [[ -n "${want[local]-}" ]]; then
  section_begin local
  if [[ -f scripts/gate.local.sh ]]; then
    timed gate.local.sh bash scripts/gate.local.sh "$mode"
  elif [[ -n "$chosen" ]]; then
    printf 'gate: no scripts/gate.local.sh; the local section has nothing to run\n'
  fi
  section_end
fi

# test_lines: one line, source lines added against test lines added since the
# merge base. It reports and never fails: the operator sets the budget. A test
# file is one named like a test, or under a tests, test or __tests__ folder, a
# *.Tests folder, or one under a folder of the test_folders answer. Source is the other code files (py, cs,
# ts, tsx, js, mjs, sh, ps1). Docs, locks and data count as neither.
test_lines() {
  local add path src=0 tst=0 f ratio
  [[ -n "$base" ]] || return 0
  while IFS=$'\t' read -r add _ path; do
    [[ "$add" =~ ^[0-9]+$ ]] || continue
    case "$path" in
      */tests/* | tests/* | */test/* | test/* | */__tests__/* | */*.Tests/* | *.Tests/* | *Tests.cs | *Test.cs | test_*.py | */test_*.py | *_test.py | *.test.* | *.spec.*{% for d in test_folders %} | {{ d }}/*{% endfor %}) tst=$((tst + add)) ;;
      *.py | *.cs | *.ts | *.tsx | *.js | *.mjs | *.sh | *.ps1) src=$((src + add)) ;;
      *) ;;
    esac
  done < <(
    git diff --numstat --no-renames "$base" --
    while IFS= read -r f; do
      printf '%d\t0\t%s\n' "$(wc -l <"$f")" "$f"
    done < <(git ls-files --others --exclude-standard)
  )
  ((src + tst > 0)) || return 0
  if ((src > 0)); then
    ratio=$(awk -v t="$tst" -v s="$src" 'BEGIN { printf "%.2f", t / s }')
    printf 'gate: test lines: +%d source, +%d test against %s (%s test lines for each source line)\n' "$src" "$tst" "${base:0:7}" "$ratio"
  else
    printf 'gate: test lines: +0 source, +%d test against %s\n' "$tst" "${base:0:7}"
  fi
}

if [[ "$mode" != fast ]]; then
  test_lines
fi

case "$mode" in
  fast) printf 'gate --fast: passed\n' ;;
  full)
    # Only when the tree is still the one that was checked.
    if [[ -n "$checked" ]]; then
      now=$(tree_key)
      [[ "$now" != "$checked" ]] || printf '%s\n' "$checked" >"$passed"
    fi
    if [[ -n "$scope" ]]; then
      printf 'gate: passed %s; run scripts/gate.sh --full before a PR\n' "$scope"
    else
      printf 'gate: every check passed\n'
    fi
    ;;
esac
