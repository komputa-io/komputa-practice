#!/usr/bin/env bash
# The repo's forge actions on GitHub, through the gh CLI. Managed by the
# project template; scripts/update-deps.sh calls it.
#   scripts/forge/github.sh check
#       fail unless gh is on PATH and signed in (GH_TOKEN in CI)
#   scripts/forge/github.sh open-update-prs
#       print "NUMBER BRANCH" for each open PR from chore/deps-weekly or an old
#       chore/update-deps- branch
#   scripts/forge/github.sh pr-create BRANCH TITLE DESCRIPTION
#       open a PR from BRANCH into the default branch; print its URL
#   scripts/forge/github.sh pr-edit NUMBER TITLE DESCRIPTION
#       replace an open PR's title and description
#   scripts/forge/github.sh pr-close NUMBER NOTE
#       close an open PR, with NOTE as its last comment
#   scripts/forge/github.sh auto-merge NUMBER SHA
#       merge the PR when its required checks pass, and only at head SHA. The PR
#       must be opened with a token that starts workflows (a personal one, not
#       GITHUB_TOKEN), so its own gate run counts. Fails, and sets nothing,
#       unless the default branch requires status checks
#   scripts/forge/github.sh issue-marked MARKER
#       print "NUMBER STATE" of the first issue (open or closed) whose text holds
#       MARKER, or nothing. Needs jq
#   scripts/forge/github.sh issue-create-high TITLE BODY
#       open an issue labelled `priority: high` (the label must exist in the repo)
set -Eeuo pipefail
shopt -s inherit_errexit
trap 'printf "%s: line %d: %s exited %d\n" "${0##*/}" "$LINENO" "$BASH_COMMAND" "$?" >&2' ERR
die() {
  printf 'forge: %s\n' "$*" >&2
  exit 1
}
usage() {
  printf 'usage: scripts/forge/github.sh check | open-update-prs | pr-create BRANCH TITLE DESCRIPTION | pr-edit NUMBER TITLE DESCRIPTION | pr-close NUMBER NOTE | auto-merge NUMBER SHA | issue-marked MARKER | issue-create-high TITLE BODY\n' >&2
  exit 2
}

check() {
  command -v gh >/dev/null || die "install gh to open the PR"
  gh auth status >/dev/null 2>&1 || die "sign gh in (or set GH_TOKEN) to open the PR"
}

open_update_prs() {
  check
  gh pr list --state open --limit 100 --json number,headRefName \
    --jq '.[] | select(.headRefName == "chore/deps-weekly" or (.headRefName | startswith("chore/update-deps-"))) | "\(.number) \(.headRefName)"' \
    || die "could not list the open PRs, so cannot tell whether an update PR is waiting"
}

pr_create() {
  check
  gh pr create --head "$1" --title "$2" --body "$3"
}

pr_edit() {
  check
  gh pr edit "$1" --title "$2" --body "$3" >/dev/null
}

pr_close() {
  check
  gh pr close "$1" --comment "$2" >/dev/null
}

auto_merge() {
  local base required
  check
  base=$(gh repo view --json defaultBranchRef --jq .defaultBranchRef.name)
  required=$(gh api "repos/{owner}/{repo}/branches/$base" --jq '.protection.required_status_checks.contexts | length')
  [[ "$required" =~ ^[1-9][0-9]*$ ]] || die "$base requires no status checks, so auto-merge is not set"
  gh pr merge "$1" --auto --merge --match-head-commit "$2"
}

# issue_marked MARKER: "NUMBER STATE" of the first issue that holds MARKER.
issue_marked() {
  check
  MARKER=$1 gh api --paginate "repos/{owner}/{repo}/issues?state=all&per_page=100" \
    --jq '.[] | select(.pull_request == null and ((.body // "") | contains(env.MARKER))) | "\(.number) \(.state)"' \
    | awk 'NR == 1' || die "could not list the issues"
}

issue_create_high() {
  check
  printf '%s' "$2" | gh api -X POST "repos/{owner}/{repo}/issues" -f "title=$1" -F body=@- -f 'labels[]=priority: high' >/dev/null
}

case "${1-}" in
  check)
    (($# == 1)) || usage
    check
    ;;
  open-update-prs)
    (($# == 1)) || usage
    open_update_prs
    ;;
  pr-edit)
    (($# == 4)) || usage
    pr_edit "$2" "$3" "$4"
    ;;
  pr-close)
    (($# == 3)) || usage
    pr_close "$2" "$3"
    ;;
  auto-merge)
    (($# == 3)) || usage
    auto_merge "$2" "$3"
    ;;
  pr-create)
    (($# == 4)) || usage
    pr_create "$2" "$3" "$4"
    ;;
  issue-marked)
    (($# == 2)) || usage
    issue_marked "$2"
    ;;
  issue-create-high)
    (($# == 3)) || usage
    issue_create_high "$2" "$3"
    ;;
  *) usage ;;
esac
