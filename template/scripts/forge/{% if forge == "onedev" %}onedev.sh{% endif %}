#!/usr/bin/env bash
# The repo's forge actions on OneDev, through its REST API. Managed by the
# project template; scripts/update-deps.sh calls it.
#   scripts/forge/onedev.sh check
#       fail unless ODEV_HOST, ODEV_PROJECT and ODEV_TOKEN are set
#   scripts/forge/onedev.sh open-update-prs
#       print "NUMBER BRANCH" for each open PR from chore/deps-weekly or an old
#       chore/update-deps- branch
#   scripts/forge/onedev.sh pr-create BRANCH TITLE DESCRIPTION
#       open a PR from BRANCH into the default branch; print its number
#   scripts/forge/onedev.sh pr-edit NUMBER TITLE DESCRIPTION
#       replace an open PR's title and description
#   scripts/forge/onedev.sh pr-close NUMBER NOTE
#       discard an open PR, with NOTE as the reason
#   scripts/forge/onedev.sh ci-passed NUMBER
#       print the PR's merge-preview commit when the CI job passed on it, or nothing
#   scripts/forge/onedev.sh ci-start NUMBER PREVIEW
#       start the CI job on PREVIEW, the PR's current merge preview, unless CI
#       already ran or runs on it; exit 0 when it started it, 1 when not
#   scripts/forge/onedev.sh merge-pr NUMBER BUILT MESSAGE
#       merge the PR with a merge commit only while its merge preview is still
#       BUILT, then delete its source branch (what odev pr merge --head does)
#   scripts/forge/onedev.sh issue-marked MARKER
#       print "NUMBER STATE" of the first issue (open or closed) whose text holds
#       MARKER, or nothing. Needs jq
#   scripts/forge/onedev.sh issue-create-high TITLE BODY
#       open an issue with Priority=Major (without that field value, the issue is filed with none and a warning)
#   scripts/forge/onedev.sh repo-public
#       print yes when anyone can read the repo's issues, else no
#   scripts/forge/onedev.sh issue-create-security TITLE BODY
#       open a confidential issue
# CI sets the three variables in .onedev-buildspec.yml.
set -Eeuo pipefail
shopt -s inherit_errexit
trap 'printf "%s: line %d: %s exited %d\n" "${0##*/}" "$LINENO" "$BASH_COMMAND" "$?" >&2' ERR
die() {
  printf 'forge: %s\n' "$*" >&2
  exit 1
}
usage() {
  printf 'usage: scripts/forge/onedev.sh check | open-update-prs | pr-create BRANCH TITLE DESCRIPTION | pr-edit NUMBER TITLE DESCRIPTION | pr-close NUMBER NOTE | ci-passed NUMBER | ci-start NUMBER PREVIEW | merge-pr NUMBER BUILT MESSAGE | issue-marked MARKER | issue-create-high TITLE BODY | repo-public | issue-create-security TITLE BODY
' >&2
  exit 2
}

check() {
  [[ -n "${ODEV_HOST-}" && -n "${ODEV_PROJECT-}" && -n "${ODEV_TOKEN-}" ]] \
    || die "set ODEV_HOST, ODEV_PROJECT and ODEV_TOKEN to open the PR"
}

# api PATH [curl args...]: one OneDev REST call. The token goes in a header
# read from a file descriptor, so it is on no command line.
api() {
  local path=$1
  shift
  curl -fsS --max-time 30 -H @<(printf 'Authorization: Bearer %s\n' "$ODEV_TOKEN") "$@" \
    "${ODEV_HOST%/}/~api/$path"
}

# json TEXT: TEXT as a JSON string body, without the quotes.
json() {
  local s=${1//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\t'/\\t}
  printf '%s' "${s//$'\n'/\\n}"
}

# open_prs: each open PR in this project as "NUMBER ID SOURCE-BRANCH", one a line.
open_prs() {
  local list
  # shellcheck disable=SC2310 # the caller reports the failure.
  list=$(api pulls -G --data-urlencode "query=\"Target Project\" is \"$ODEV_PROJECT\" and open" \
    --data-urlencode offset=0 --data-urlencode count=100) || return 1
  # The API puts one field on a line, with no indent, so only the brace depth tells
  # a PR's own fields (depth 2) from those of an object nested in it. Braces inside
  # a string do not count. awk reads it all, so curl is never cut off.
  awk '
    function field(line) {
      sub(/^[^:]*:[[:space:]]*/, "", line)
      gsub(/[",[:space:]]/, "", line)
      return line
    }
    depth == 2 && /^[[:space:]]*"id"[[:space:]]*:/ { id = field($0) }
    depth == 2 && /^[[:space:]]*"number"[[:space:]]*:/ { num = field($0) }
    depth == 2 && /^[[:space:]]*"sourceBranch"[[:space:]]*:/ { branch = field($0) }
    {
      s = $0
      gsub(/"([^"\\]|\\.)*"/, "", s)
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "{" || c == "[") {
          if (++depth == 2) { id = ""; num = ""; branch = "" }
        } else if (c == "}" || c == "]") {
          if (depth-- == 2 && num != "") print num, id, branch
        }
      }
    }
  ' <<<"$list"
}

# pr_id NUMBER: the global id of an open PR in this project; the API takes it, not the number.
pr_id() {
  local list id
  # shellcheck disable=SC2310 # the status is the answer.
  list=$(open_prs) || die "could not list the open PRs"
  id=$(awk -v n="$1" '$1 == n { print $2; exit }' <<<"$list")
  [[ "$id" =~ ^[1-9][0-9]*$ ]] || die "no open PR #$1 in $ODEV_PROJECT"
  printf '%s' "$id"
}

open_update_prs() {
  local list
  check
  # shellcheck disable=SC2310 # the status is the answer.
  list=$(open_prs) || die "could not list the open PRs, so cannot tell whether an update PR is waiting"
  awk '$3 == "chore/deps-weekly" || $3 ~ /^chore\/update-deps-/ { print $1, $3 }' <<<"$list"
}

# post ID ACTION TEXT: a PR action whose body is raw text (OneDev reads the entity as it is).
post() {
  printf '%s' "$3" | api "pulls/$1/$2" -X POST -H 'Content-Type: application/json' --data-binary @- >/dev/null
}

pr_edit() {
  local id
  check
  id=$(pr_id "$1")
  post "$id" title "$2"
  post "$id" description "$3"
}

pr_close() {
  local id
  check
  id=$(pr_id "$1")
  post "$id" discard "$2"
}

# pr_field ID NAME: a string field of the PR.
pr_field() {
  api "pulls/$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -n 1
}

ci_passed() {
  local id built
  check
  id=$(pr_id "$1")
  built=$(pr_field "$id" buildCommitHash)
  [[ "$built" =~ ^[0-9a-f]{40}$ ]] || return 0
  # Each build's own status is the first one after its commitHash; step statuses follow.
  api "pulls/$id/current-builds" | awk -v built="$built" -v number="$1" '
    /"jobName"/ { job = $3; gsub(/[",]/, "", job); commit = ""; seen = 0 }
    /"commitHash"/ { commit = $3; gsub(/[",]/, "", commit) }
    /"status"/ && commit != "" && !seen { seen = 1; if (job == "CI" && commit == built && $3 ~ /SUCCESSFUL/) ok = 1 }
    END { if (ok) print built }'
}

# ci_start NUMBER PREVIEW: run again every job that ran on the PR (its merge needs
# them all on the current preview), or CI when none ran.
ci_start() {
  local id built jobs job
  check
  id=$(pr_id "$1")
  built=$(pr_field "$id" buildCommitHash)
  [[ "$built" != "$2" ]] || return 1
  jobs=$(api "pulls/$id/current-builds" | sed -n 's/^[[:space:]]*"jobName"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | sort -u)
  while IFS= read -r job; do
    # shellcheck disable=SC2310 # the caller's if must not hide a failed start.
    printf '{"@type": "JobRunOnPullRequest", "pullRequestId": %s, "jobName": "%s", "params": {}, "reason": "the default branch moved"}' "$id" "$(json "$job")" \
      | api job-runs -X POST -H 'Content-Type: application/json' --data-binary @- >/dev/null \
      || die "could not start $job on #$1; the token needs the right to run jobs"
  done <<<"${jobs:-CI}"
}

merge_pr() {
  local id project now
  check
  id=$(pr_id "$1")
  now=$(pr_field "$id" buildCommitHash)
  [[ "$now" == "$2" ]] || die "PR #$1 moved since CI passed; not merged"
  # shellcheck disable=SC2310 # the die names the cause; curl alone says 406.
  printf '%s' "$3" | api "pulls/$id/merge" -X POST -H 'Content-Type: application/json' --data-binary @- >/dev/null \
    || die "OneDev refused to merge #$1: a job or review it requires has not passed on the merge preview"
  project=$(api "projects/ids/$ODEV_PROJECT")
  api "repositories/$project/branches/chore%2Fdeps-weekly" -X DELETE >/dev/null
}

pr_create() {
  local branch=$1 title=$2 desc=$3 id base body pull number
  check
  id=$(api "projects/ids/$ODEV_PROJECT")
  [[ "$id" =~ ^[1-9][0-9]*$ ]] || die "OneDev has no project $ODEV_PROJECT"
  base=$(api "repositories/$id/default-branch")
  [[ "$base" =~ ^[A-Za-z0-9._/-]+$ ]] || die "OneDev gave no usable default branch for $ODEV_PROJECT"
  printf -v body '{"targetProjectId": %s, "sourceProjectId": %s, "targetBranch": "%s", "sourceBranch": "%s", "title": "%s", "description": "%s", "mergeStrategy": "CREATE_MERGE_COMMIT"}' \
    "$id" "$id" "$(json "$base")" "$(json "$branch")" "$(json "$title")" "$(json "$desc")"
  # OneDev answers with the pull request's global id; its number is a read away.
  # OneDev pretty-prints JSON with a space before each colon.
  pull=$(printf '%s' "$body" | api pulls -H 'Content-Type: application/json' --data-binary @-)
  [[ "$pull" =~ ^[1-9][0-9]*$ ]] || die "OneDev did not open the PR: $pull"
  number=$(api "pulls/$pull" | sed -n 's/.*"number"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
  printf '#%s\n' "${number:-?}"
}

# issue_marked MARKER: "NUMBER STATE" of the first issue whose first line is MARKER.
issue_marked() {
  local off=0 page n hit
  check
  while :; do
    # shellcheck disable=SC2310 # the failure is handled here, on purpose
    page=$(api issues -G --data-urlencode "query=\"Project\" is \"$ODEV_PROJECT\"" --data-urlencode "offset=$off" --data-urlencode count=100) \
      || die "could not list the issues"
    hit=$(jq -r --arg m "$1" '[.[] | select(((.description // "") | split("\n")[0] | rtrimstr("\r")) == $m)][0] // empty | "\(.id) \(.state | ascii_downcase | if . == "closed" then "closed" else "open" end)"' <<<"$page")
    [[ -z "$hit" ]] || {
      printf '%s\n' "$hit"
      return 0
    }
    n=$(jq length <<<"$page")
    ((n == 100)) || return 0
    off=$((off + 100))
  done
}

issue_create_high() {
  local pid
  check
  pid=$(api "projects/ids/$ODEV_PROJECT")
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || die "OneDev has no project $ODEV_PROJECT"
  # A project without the Priority field (or its Major value) refuses it: file without it and say so.
  # shellcheck disable=SC2310 # the failure is handled here, on purpose
  new_issue "$1" "$2" '{"Priority": "Major"}' "$pid" 2>/dev/null || {
    printf 'forge: WARNING the project has no Priority=Major (or refused it); filing without it\n' >&2
    new_issue "$1" "$2" '{}' "$pid"
  }
}
new_issue() { # title, description, fields as JSON, project id
  jq -n --argjson p "$4" --arg t "$1" --arg d "$2" --argjson f "$3" '{title: $t, projectId: $p, description: $d, fields: $f}' \
    | api issues -X POST -H 'Content-Type: application/json' --data-binary @- >/dev/null
}

# A OneDev issue is never public: the confidential flag below limits it further.
repo_public() { echo no; }

issue_create_security() {
  local pid
  check
  pid=$(api "projects/ids/$ODEV_PROJECT")
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || die "OneDev has no project $ODEV_PROJECT"
  jq -n --argjson p "$pid" --arg t "$1" --arg d "$2" '{title: $t, projectId: $p, description: $d, confidential: true, fields: {}}' \
    | api issues -X POST -H 'Content-Type: application/json' --data-binary @- >/dev/null
}

case "${1-}" in
  check)
    (($# == 1)) || usage
    check
    ;;
  open-update-prs)
    (($# == 1)) || usage
    open_update_prs
    ;;
  pr-edit)
    (($# == 4)) || usage
    pr_edit "$2" "$3" "$4"
    ;;
  pr-close)
    (($# == 3)) || usage
    pr_close "$2" "$3"
    ;;
  ci-passed)
    (($# == 2)) || usage
    ci_passed "$2"
    ;;
  ci-start)
    (($# == 3)) || usage
    ci_start "$2" "$3"
    ;;
  merge-pr)
    (($# == 4)) || usage
    merge_pr "$2" "$3" "$4"
    ;;
  pr-create)
    (($# == 4)) || usage
    pr_create "$2" "$3" "$4"
    ;;
  issue-marked)
    (($# == 2)) || usage
    issue_marked "$2"
    ;;
  issue-create-high)
    (($# == 3)) || usage
    issue_create_high "$2" "$3"
    ;;
  repo-public)
    (($# == 1)) || usage
    repo_public
    ;;
  issue-create-security)
    (($# == 3)) || usage
    issue_create_security "$2" "$3"
    ;;
  *) usage ;;
esac
