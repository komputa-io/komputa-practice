# The Security review: Strix and the Cloudflare security-audit skill over the source (pins in
# scripts/security.pin), and one issue for each finding. By hand (workflow_dispatch), and on
# day {{ 1 + schedule_slot % 28 }} of each month at {{ '%02d:%02d' | format(nightly_hour, nightly_minute) }} UTC (schedule_slot {{ schedule_slot }}). It runs on {{ default_branch }} only: the job holds an LLM
# key, and code on another branch could carry a prompt injection that leaks it. Both the job's
# `if` and scripts/security-review.sh refuse any other ref.
# It needs a self-hosted runner with the label `security`, on a host that nothing else uses
# (Strix needs the Docker socket).
# A public repo files no issue (a finding would disclose a live vulnerability): read the
# artifact instead.
# The job runs in the GitHub environment `security-review`. The operator creates that environment
# once, limits its deployment branches to {{ default_branch }}, and puts SECURITY_LLM_KEY (and
# SECURITY_LLM_BASE) in the environment, not in the repo secrets. A branch can edit this file, but
# it cannot read the environment's secrets. The job also runs on a private repo only: on a public
# repo, any signed-in user can download the artifact, and a fork pull request can reach the runner.
name: security-review

on:
  schedule:
    - cron: '{{ nightly_minute }} {{ nightly_hour }} {{ 1 + schedule_slot % 28 }} * *'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  security-review:
    name: Security review
    if: {% raw %}${{ github.event.repository.private &&{% endraw %} github.ref == 'refs/heads/{{ default_branch }}' }}
    environment: security-review
    runs-on: [self-hosted, security]
    timeout-minutes: 120
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - run: scripts/security-review.sh --apply --budget {{ security_budget_usd }} --threat-model '{{ threat_model }}'
        env:
          SECURITY_LLM_KEY: {% raw %}${{ secrets.SECURITY_LLM_KEY }}{% endraw %}
          SECURITY_LLM_BASE: {% raw %}${{ vars.SECURITY_LLM_BASE }}{% endraw %}
          SECURITY_DEFAULT_BRANCH: {{ default_branch }}
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        if: {% raw %}${{ !cancelled() }}{% endraw %}
        with:
          name: security-review-findings
          path: security-review-out/findings.json
          if-no-files-found: ignore

  # The issues come from a second job on a GitHub-hosted runner, so the LLM key and the Docker
  # host never see the issue token, and the issue token never sees the key.
  file-issues:
    name: File the findings
    needs: security-review
    if: {% raw %}${{ !cancelled() && needs.security-review.result == 'success' }}{% endraw %}
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      issues: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          name: security-review-findings
          path: security-review-out
      - run: scripts/security-issues.sh --forge github --findings security-review-out/findings.json --post
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
