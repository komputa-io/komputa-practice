{%- set langs = [] -%}
{%- for l in ['python', 'dotnet', 'typescript', 'rust'] if l in languages -%}{%- set _ = langs.append(l) -%}{%- endfor -%}
{#- The same images as gate.yml and the OneDev build spec. -#}
{%- set split = 'dotnet' in languages or 'typescript' in languages or 'rust' in languages -%}
{%- set images = {
  'python': 'ghcr.io/astral-sh/uv:python' ~ (python_floor | default('3.13')) ~ '-bookworm',
  'dotnet': 'mcr.microsoft.com/dotnet/sdk:10.0',
  'typescript': 'node:24-bookworm',
  'rust': 'rust:' ~ (rust_version | default('1.89.0')) ~ '-bookworm',
  'shell': 'ghcr.io/astral-sh/uv:bookworm',
} -%}
{%- set names = {'python': 'Python', 'dotnet': '.NET', 'typescript': 'TypeScript', 'rust': 'Rust'} -%}
{%- macro env(l) %}
{%- if l == 'python' and private_index %}
    env:
      UV_INDEX_{{ private_index_name | upper | replace('-', '_') }}_USERNAME: {% raw %}${{ secrets.PKG_USER }}{% endraw %}
      UV_INDEX_{{ private_index_name | upper | replace('-', '_') }}_PASSWORD: {% raw %}${{ secrets.PKG_TOKEN }}{% endraw %}
{%- elif l == 'dotnet' and nuget_feed %}
    env:
      NUGET_{{ nuget_feed_name | upper | replace('-', '_') }}_USERNAME: {% raw %}${{ secrets.NUGET_USER }}{% endraw %}
      NUGET_{{ nuget_feed_name | upper | replace('-', '_') }}_PASSWORD: {% raw %}${{ secrets.NUGET_TOKEN }}{% endraw %}
{%- endif %}
{%- endmacro %}
{%- macro refresh(job, title, image, l, args) %}
  {{ job }}:
    name: {{ title }}
    runs-on: ubuntu-latest
    timeout-minutes: 60
    container: {{ image }}
{{- env(l) }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - run: git config --global --add safe.directory "$GITHUB_WORKSPACE"
{%- if l == 'images' or not split %}
      # skopeo looks up image digests. No CI image has it, and Debian packages it.
      # A failed install only skips the image section, which says so.
      - run: apt-get update -qq && apt-get install -y -qq --no-install-recommends skopeo >/dev/null || true
{%- endif %}
{%- if l == 'typescript' %}
      - run: cd '{{ node_dir }}' && npm ci --no-audit --no-fund
{%- elif l == 'rust' %}
      - run: rustup component add clippy rustfmt && scripts/install-cargo-deny.sh
{%- endif %}
      - run: scripts/update-deps.sh --refresh-only{{ args }}
      # Hand the change to the job that opens the PR.
      - run: |
          git add -A
          mkdir out
          git diff --cached --binary >out/{{ job }}.patch
          cp "$(git rev-parse --git-dir)/update-deps-images.txt" out/ 2>/dev/null || true
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
        with:
          name: {{ job }}
          path: out
{%- endmacro -%}
# Every {{ ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'][weekly_day] }} at {{ '%02d:%02d' | format(weekly_hour, weekly_minute) }} UTC, refresh the dependencies within their ranges and open a PR, as
# the OneDev build spec does. Start it by hand with workflow_dispatch. The refresh
# jobs run in the gate's images and write no secret but the read-only package
# logins; the last job has the write token. It needs the repository settings
# "Allow GitHub Actions to create and approve pull requests" and "Allow
# auto-merge" on. One PR a project: the job replaces chore/deps-weekly and
# updates its open PR. A PR opened with the job token does not start the gate, so
# the last job starts it on the branch with workflow_dispatch (gate.yml needs
# that trigger), then sets the PR to merge when the required checks pass, for a
# PR that changes dependency files only.
name: update-deps

on:
  schedule:
    - cron: '{{ weekly_minute }} {{ weekly_hour }} * * {{ (weekly_day + 1) % 7 }}'
  workflow_dispatch:

permissions:
  contents: read

# One run at a time, so a manual run beside the weekly run does not fail on push.
# A run in progress is never cancelled; the next waits.
concurrency:
  group: update-deps
  cancel-in-progress: false

defaults:
  run:
    shell: bash

jobs:
{%- if not split %}
{{- refresh('refresh', 'Refresh', images['python' if 'python' in languages else 'shell'], 'python' if 'python' in languages else 'shell', '') }}
{%- else %}
{%- for l in langs %}
{{ refresh('refresh-' ~ l, 'Refresh ' ~ names[l], images[l], l, ' --only ' ~ l) }}
{%- endfor %}
{{ refresh('refresh-images', 'Refresh image pins', images['shell'], 'images', ' --only images --only deslop') }}
{%- endif %}

  open-pr:
    name: Open a PR
    needs: [{% if not split %}refresh{% else %}{% for l in langs %}refresh-{{ l }}, {% endfor %}refresh-images{% endif %}]
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
      pull-requests: write
      actions: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
        with:
          path: {% raw %}${{ runner.temp }}{% endraw %}/out
      - run: |
          for p in "$RUNNER_TEMP"/out/*/*.patch; do
            if [[ -s "$p" ]]; then git apply --index "$p"; fi
          done
          for n in "$RUNNER_TEMP"/out/*/update-deps-images.txt; do
            if [[ -f "$n" ]]; then cp "$n" "$(git rev-parse --git-dir)/"; fi
          done
          git config user.name "Dependency update"
          git config user.email "deps@${GITHUB_SERVER_URL#https://}"
          scripts/update-deps.sh --publish-only
        env:
          GH_TOKEN: {% raw %}${{ github.token }}{% endraw %}
