{%- set langs = [] -%}
{%- for l in ['python', 'dotnet', 'typescript', 'rust'] if l in languages -%}{%- set _ = langs.append(l) -%}{%- endfor -%}
{#- No image holds .NET, Node or Rust beside uv, so those split the job: one step per
    section, each in its own image. Python and shell share the uv image. -#}
{%- set split = 'dotnet' in languages or 'typescript' in languages or 'rust' in languages -%}
{%- set images = {
  'python': 'ghcr.io/astral-sh/uv:python' ~ (python_floor | default('3.13')) ~ '-bookworm',
  'dotnet': 'mcr.microsoft.com/dotnet/sdk:10.0',
  'typescript': 'node:24-bookworm',
  'rust': 'rust:' ~ (rust_version | default('1.89.0')) ~ '-bookworm',
  'shell': 'ghcr.io/astral-sh/uv:bookworm',
} -%}
{%- set names = {'python': 'Python', 'dotnet': '.NET', 'typescript': 'TypeScript', 'rust': 'Rust'} -%}
{%- macro pyenv() %}
{%- if private_index %}
    # The private package index needs a login. PKG_USER and PKG_TOKEN are job
    # secrets from a read-only account (Package Reader on that index's project).
    envVars:
    - name: UV_INDEX_{{ private_index_name | upper | replace('-', '_') }}_USERNAME
      value: '@secret:PKG_USER@'
    - name: UV_INDEX_{{ private_index_name | upper | replace('-', '_') }}_PASSWORD
      value: '@secret:PKG_TOKEN@'
{%- endif %}
{%- endmacro %}
{%- macro nugetenv() %}
{%- if nuget_feed %}
    # The private NuGet feed needs a login: the job secrets NUGET_USER and
    # NUGET_TOKEN, from a read-only account. nuget.config reads these variables.
    envVars:
    - name: NUGET_{{ nuget_feed_name | upper | replace('-', '_') }}_USERNAME
      value: '@secret:NUGET_USER@'
    - name: NUGET_{{ nuget_feed_name | upper | replace('-', '_') }}_PASSWORD
      value: '@secret:NUGET_TOKEN@'
{%- endif %}
{%- endmacro %}
{%- macro publish_setup() %}
        export ODEV_HOST='@server_url@' ODEV_PROJECT='@project_path@'
        # The checkout's header carries the job credential, which cannot push.
        git config --local --name-only --get-regexp '^http\..*\.extraheader$' \
          | while read -r key; do git config --local --unset-all "$key"; done
        git config credential.helper '!f() { echo "username=$ODEV_USER"; echo "password=$ODEV_TOKEN"; }; f'
        git config user.name "Dependency update"
        git config user.email "deps@@noreply.invalid"
{%- endmacro -%}
version: 35
jobs:
# CI runs the gate on every pull request into main and on every push to main.
# It has no build or deploy step. {% if private_index or nuget_feed %}Its only secrets are the read-only logins
# for the private package {% if private_index and nuget_feed %}index and feed{% elif private_index %}index{% else %}feed{% endif %}.{% else %}It asks for no secret.{% endif %} Add deploy jobs
# below it; this file is seeded once and then belongs to the repo.
#
# An at-sign is interpolation syntax in a commands block, comments included.
# A literal one must be doubled.
- name: CI
  steps:
  - !CheckoutStep
    name: Checkout
    cloneCredential: !DefaultCredential {}
    withLfs: false
    withSubmodules: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- if not split %}
  - !CommandStep
    name: Gate
    runInContainer: true
    image: {{ images['python' if 'python' in languages else 'shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        scripts/gate.sh --full
{{- pyenv() }}
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- else %}
{%- for l in langs %}
  - !CommandStep
    name: Gate {{ names[l] }}
    runInContainer: true
    image: {{ images[l] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
{%- if l == 'typescript' %}
        (cd '{{ node_dir }}' && npm ci --no-audit --no-fund)
{%- elif l == 'rust' %}
        # The image has no clippy, rustfmt or cargo-deny.
        rustup component add clippy rustfmt
        scripts/install-cargo-deny.sh
{%- endif %}
        scripts/gate.sh --only {{ l }}
{%- if l == 'python' %}{{ pyenv() }}{% elif l == 'dotnet' %}{{ nugetenv() }}{% endif %}
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- endfor %}
  # Shell checks and the repo's own scripts/gate.local.sh. Give this step an
  # image with what gate.local.sh needs.
  - !CommandStep
    name: Gate shell and local
    runInContainer: true
    image: {{ images['shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        scripts/gate.sh --only shell --only local
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- endif %}
  triggers:
  - !BranchUpdateTrigger
    branches: main
  - !PullRequestUpdateTrigger
    branches: main
  retryCondition: never
  maxRetries: 3
  retryDelay: 30
  timeout: 3600

# Weekly: refresh dependencies within their ranges and open a PR. Needs two
# job secrets on main, from an account that can push a branch and open a pull
# request: ONEDEV_USER (its login) and ONEDEV_TOKEN (its access token). OneDev
# checks the login with the token. Set them once, from your own shell:
#   odev secret set ONEDEV_USER          (the login on stdin)
#   {{ vault_command }} <item> | odev secret set ONEDEV_TOKEN
# scripts/update-deps.sh opens the PR with curl through the OneDev REST API.{% if split %}
# No image holds every toolchain, so each language refreshes in its own step and
# the last step commits them all and opens the PR.{% endif %}
- name: Update dependencies
  steps:
  - !CheckoutStep
    name: Checkout
    # The default credential cannot push; the last step swaps in the token. Naming
    # the secret here instead would make OneDev reject the whole spec, CI job
    # included, in any repo that has not set it yet.
    cloneCredential: !DefaultCredential {}
    withLfs: false
    withSubmodules: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- if not split %}
  - !CommandStep
    name: Refresh and open a PR
    runInContainer: true
    image: {{ images['python' if 'python' in languages else 'shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
{{- publish_setup() }}
        # skopeo looks up image digests for the refresh's image section. No CI
        # image has it or docker, and Debian packages it. A failed install only
        # skips the image section, which says so.
        apt-get update -qq && apt-get install -y -qq --no-install-recommends skopeo >/dev/null || true
        scripts/update-deps.sh
    envVars:
    - name: ODEV_USER
      value: '@secret:ONEDEV_USER@'
    - name: ODEV_TOKEN
      value: '@secret:ONEDEV_TOKEN@'
{%- if private_index %}
    # uv lock reads the private package index with the read-only login.
    - name: UV_INDEX_{{ private_index_name | upper | replace('-', '_') }}_USERNAME
      value: '@secret:PKG_USER@'
    - name: UV_INDEX_{{ private_index_name | upper | replace('-', '_') }}_PASSWORD
      value: '@secret:PKG_TOKEN@'
{%- endif %}
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- else %}
{%- for l in langs %}
  - !CommandStep
    name: Refresh {{ names[l] }}
    runInContainer: true
    image: {{ images[l] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        scripts/update-deps.sh --refresh-only --only {{ l }}
{%- if l == 'python' %}{{ pyenv() }}{% elif l == 'dotnet' %}{{ nugetenv() }}{% endif %}
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- endfor %}
  - !CommandStep
    name: Refresh image pins
    runInContainer: true
    image: {{ images['shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        # skopeo looks up image digests for the refresh's image section. No CI
        # image has it or docker, and Debian packages it. A failed install only
        # skips the image section, which says so.
        apt-get update -qq && apt-get install -y -qq --no-install-recommends skopeo >/dev/null || true
        scripts/update-deps.sh --refresh-only --only images
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !CommandStep
    name: Open a PR
    runInContainer: true
    image: {{ images['shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
{{- publish_setup() }}
        scripts/update-deps.sh --publish-only
    envVars:
    - name: ODEV_USER
      value: '@secret:ONEDEV_USER@'
    - name: ODEV_TOKEN
      value: '@secret:ONEDEV_TOKEN@'
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- endif %}
  triggers:
  - !ScheduleTrigger
    cronExpression: 0 0 4 ? * MON
  retryCondition: never
  maxRetries: 0
  timeout: 3600
