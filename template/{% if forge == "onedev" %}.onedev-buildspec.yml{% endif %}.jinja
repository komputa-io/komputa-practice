{%- set langs = [] -%}
{%- for l in ['python', 'dotnet', 'typescript', 'rust'] if l in languages -%}{%- set _ = langs.append(l) -%}{%- endfor -%}
{#- No image holds .NET, Node or Rust beside uv, so those split the job: one step per
    section, each in its own image. Python and shell share the uv image. -#}
{%- set split = 'dotnet' in languages or 'typescript' in languages or 'rust' in languages -%}
{%- set images = {
  'python': 'ghcr.io/astral-sh/uv:python' ~ (python_floor | default('3.13')) ~ '-bookworm',
  'dotnet': 'mcr.microsoft.com/dotnet/sdk:10.0',
  'typescript': 'node:24-bookworm',
  'rust': 'rust:' ~ (rust_version | default('1.89.0')) ~ '-bookworm',
  'shell': 'ghcr.io/astral-sh/uv:bookworm',
  'deslop': 'ghcr.io/astral-sh/uv:trixie',
} -%}
{%- set names = {'python': 'Python', 'dotnet': '.NET', 'typescript': 'TypeScript', 'rust': 'Rust'} -%}
{%- macro pyenv() %}
{%- if private_index %}
    # The private package index needs a login. PKG_USER and PKG_TOKEN are job
    # secrets from a read-only account (Package Reader on that index's project).
    envVars:
    - name: UV_INDEX_{{ private_index_name | upper | replace('-', '_') }}_USERNAME
      value: '@secret:PKG_USER@'
    - name: UV_INDEX_{{ private_index_name | upper | replace('-', '_') }}_PASSWORD
      value: '@secret:PKG_TOKEN@'
{%- endif %}
{%- endmacro %}
{%- macro nugetenv() %}
{%- if nuget_feed %}
    # The private NuGet feed needs a login: the job secrets NUGET_USER and
    # NUGET_TOKEN, from a read-only account. nuget.config reads these variables.
    envVars:
    - name: NUGET_{{ nuget_feed_name | upper | replace('-', '_') }}_USERNAME
      value: '@secret:NUGET_USER@'
    - name: NUGET_{{ nuget_feed_name | upper | replace('-', '_') }}_PASSWORD
      value: '@secret:NUGET_TOKEN@'
{%- endif %}
{%- endmacro %}
{%- macro fetch_target() %}
        # The gate scopes a build by its merge base with {{ default_branch }}. A pull request whose
        # head is itself a merge commit has no safe first parent, so fetch {{ default_branch }} (the
        # checkout leaves its credential in the git config). If this fails, the gate
        # runs every section: HEAD^1 is not a safe base (a fast-forwarded pull request
        # head is not a merge preview), so a failed fetch never narrows the run.
        FULL=
        git fetch --quiet origin '+refs/heads/{{ default_branch }}:refs/remotes/origin/{{ default_branch }}' || { FULL=--full; echo "No target branch fetched; the gate runs every section."; }
{%- endmacro %}
{%- macro publish_setup() %}
        export ODEV_HOST='@server_url@' ODEV_PROJECT='@project_path@'
        # The checkout's header carries the job credential, which cannot push.
        git config --local --name-only --get-regexp '^http\..*\.extraheader$' \
          | while read -r key; do git config --local --unset-all "$key"; done
        git config credential.helper '!f() { echo "username=$ODEV_USER"; echo "password=$ODEV_TOKEN"; }; f'
        git config user.name "Dependency update"
        git config user.email "deps@@noreply.invalid"
{%- endmacro %}
{%- macro ci_job(name, mode) %}
- name: {{ name }}
  steps:
  - !CheckoutStep
    name: Checkout
    cloneCredential: !DefaultCredential {}
    withLfs: false
    withSubmodules: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- if mode != 'plain' %}
  - !CommandStep
    name: Record the tree
    runInContainer: true
    image: {{ images['shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        # Each build records the tree it tests, so a later build of the same
        # tree can trust it. printf, not echo: a trailing newline would become
        # part of the version and match nothing.
        tree=$(git rev-parse 'HEAD^{tree}')
        [ -n "$tree" ] || { echo "No tree for HEAD." >&2; exit 1; }
        printf '%s' "$tree" > .git/ci-tree
        cat .git/ci-tree
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !SetBuildVersionStep
    name: Stamp the build with its tree
    buildVersion: '@file:.git/ci-tree@'
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- endif %}
{%- if mode == 'main' %}
  - !CommandStep
    name: Trust a green CI build
    runInContainer: true
    image: {{ images['shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -u
        # Writes .git/ci-trusted when a green CI build ran on exactly this tree,
        # so the gate steps below skip: the build of a push to {{ default_branch }} runs on the
        # tree that the pull request's build passed (a merge with {{ default_branch }} unmoved
        # has its merge preview's tree). Fails open: every way out short of the
        # last line leaves no marker and exits 0, so anything unexpected runs
        # the gate. The token goes to curl on stdin, not on its command line.
        MARK=.git/ci-trusted
        rm -f "$MARK"
        full() { echo "No trusted CI build: $1. The gate runs."; exit 0; }
        TREE=$(cat .git/ci-tree) || full "no recorded tree"
        [ -n "$TREE" ] || full "the recorded tree is empty"
        [ -n "${ONEDEV_TOKEN-}" ] || full "no token"
        BODY=$(printf 'header = "Authorization: Bearer %s"\n' "$ONEDEV_TOKEN" \
          | curl -fsS --max-time 30 -K - -G \
            --data-urlencode "query=\"Project\" is \"@project_path@\" and \"Job\" is \"CI\" and successful and \"Version\" is \"$TREE\"" \
            --data-urlencode offset=0 --data-urlencode count=1 '@server_url@/~api/builds') \
          || full "the build query failed"
        # The query already asks for these; the answer is checked again rather
        # than trusted to have honoured it.
        FOUND=$(printf '%s' "$BODY" | python3 -c '
        import json, sys
        tree = sys.argv[1]
        try:
            hits = [b for b in json.load(sys.stdin)
                    if b.get("jobName") == "CI" and b.get("status") == "SUCCESSFUL" and b.get("version") == tree]
            print("CI #%d (commit %s, tree %s)" % (hits[0]["number"], hits[0]["commitHash"][:7], tree))
        except (ValueError, TypeError, AttributeError, KeyError, IndexError):
            sys.exit(1)
        ' "$TREE") || full "no green CI build has tree $TREE"
        printf '%s\n' "$FOUND" > "$MARK"
        echo "Trusting $FOUND."
    envVars:
    - name: ONEDEV_TOKEN
      value: '@secret:ONEDEV_TOKEN@'
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- endif %}
{%- if not split %}
  - !CommandStep
    name: Gate
    runInContainer: true
    image: {{ images['python' if 'python' in languages else 'shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
{%- if mode == 'main' %}
        # Written by "Trust a green CI build" only; under .git, so no commit can
        # carry one in.
        if [ -f .git/ci-trusted ]; then
          echo "Trusting $(cat .git/ci-trusted): this gate is skipped."
          exit 0
        fi
{%- endif %}
{{- fetch_target() }}
        scripts/gate.sh --full
{{- pyenv() }}
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- else %}
{%- for l in langs %}
  - !CommandStep
    name: Gate {{ names[l] }}
    runInContainer: true
    image: {{ images[l] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
{%- if mode == 'main' %}
        # Written by "Trust a green CI build" only; under .git, so no commit can
        # carry one in.
        if [ -f .git/ci-trusted ]; then
          echo "Trusting $(cat .git/ci-trusted): this gate is skipped."
          exit 0
        fi
{%- endif %}
{%- if l == 'typescript' %}
        (cd '{{ node_dir }}' && npm ci --no-audit --no-fund)
{%- elif l == 'rust' %}
        # The image has no clippy, rustfmt or cargo-deny.
        rustup component add clippy rustfmt
        scripts/install-cargo-deny.sh
{%- endif %}
{{- fetch_target() }}
        # CI set: the gate skips a section that the change does not touch.
        CI=true scripts/gate.sh --only {{ l }} $FULL
{%- if l == 'python' %}{{ pyenv() }}{% elif l == 'dotnet' %}{{ nugetenv() }}{% endif %}
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- endfor %}
  # Shell checks and the repo's own scripts/gate.local.sh. Give this step an
  # image with what gate.local.sh needs.
  - !CommandStep
    name: Gate shell and local
    runInContainer: true
    image: {{ images['shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
{%- if mode == 'main' %}
        # Written by "Trust a green CI build" only; under .git, so no commit can
        # carry one in.
        if [ -f .git/ci-trusted ]; then
          echo "Trusting $(cat .git/ci-trusted): this gate is skipped."
          exit 0
        fi
{%- endif %}
{{- fetch_target() }}
        CI=true scripts/gate.sh --only shell --only local $FULL
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- endif %}
  triggers:
{%- if mode != 'pr' %}
  - !BranchUpdateTrigger
    branches: {{ default_branch }}
{%- endif %}
{%- if mode != 'main' %}
  - !PullRequestUpdateTrigger
    branches: {{ default_branch }}
{%- endif %}
  retryCondition: never
  maxRetries: 3
  retryDelay: 30
  timeout: 3600
{%- endmacro %}
version: 35
jobs:
# CI runs the gate on every pull request into {{ default_branch }} and on every push to {{ default_branch }}.{% if trust_green_ci %}
# Two jobs hold the one gate. "CI on main" skips it when a green CI build of a
# pull request ran on exactly this tree. It needs one job secret on main, the
# access token of an account that can read this project's builds:
#   {{ vault_command }} <item> | odev secret set ONEDEV_TOKEN
# (authorized on main only: a pull request's build must not read it).{% endif %}
# It has no build or deploy step. {% if private_index or nuget_feed %}Its only secrets are the read-only logins
# for the private package {% if private_index and nuget_feed %}index and feed{% elif private_index %}index{% else %}feed{% endif %}.{% else %}It asks for no secret.{% endif %} Add deploy jobs
# below it; this file is seeded once and then belongs to the repo.
#
# An at-sign is interpolation syntax in a commands block, comments included.
# A literal one must be doubled.
{%- if trust_green_ci %}
{{ ci_job('CI', 'pr') }}
{{ ci_job('CI on main', 'main') }}
{%- else %}
{{ ci_job('CI', 'plain') }}
{%- endif %}

# Duplicate code that a pull request adds, found by Deslop (version and checksum
# in scripts/deslop.pin). It runs on pull requests only, in a job of its own so a
# missing secret fails this job and not CI. It leaves one comment on the PR and
# edits it on each push. {% if deslop_fail_over %}It fails the PR above {{ deslop_fail_over }}% of the added lines.{% endif %}
# It fails while a duplicate the PR adds has no decision: fixed, or kept in
# .deslop-decisions (scripts/deslop-decisions.sh).
# The comment needs one job secret, the access token of an account that may
# only comment on pull requests: ONEDEV_COMMENT_TOKEN. OneDev authorises a pull
# request's build by its source branch, so the secret must be readable on every
# branch; a narrow account is what keeps that safe. Set it once, from your own
# shell:
#   {{ vault_command }} <item> | odev secret set ONEDEV_COMMENT_TOKEN --branches '**'
# The comment goes through curl and the REST API; the token is read from the
# environment, never from an argument. A failed comment prints a WARNING line
# and leaves the job green.
- name: Duplicate code
  steps:
  - !CheckoutStep
    name: Checkout
    cloneCredential: !DefaultCredential {}
    withLfs: false
    withSubmodules: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !CommandStep
    name: Deslop
    runInContainer: true
    image: {{ images['deslop'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        apt-get update -qq && apt-get install -y -qq --no-install-recommends curl jq >/dev/null
        git fetch -q origin {{ default_branch }}:refs/remotes/origin/{{ default_branch }}
        rc=0
        scripts/deslop-pr.sh origin/{{ default_branch }}{% if deslop_fail_over %} --fail-over {{ deslop_fail_over }}{% endif %} || rc=$?
        export ODEV_HOST='@server_url@' ODEV_PROJECT='@project_path@'
        scripts/deslop-comment.sh --forge onedev --pr '@pull_request_number@' --report .deslop-pr/deslop-report.json --post \
          || echo 'WARNING deslop: the PR comment was not posted (see the error above)'
        if [ "$rc" -eq 0 ]; then
          scripts/deslop-decisions.sh --report .deslop-pr/deslop-report.json || rc=$?
        fi
        exit "$rc"
    envVars:
    - name: ODEV_TOKEN
      value: '@secret:ONEDEV_COMMENT_TOKEN@'
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !PublishArtifactStep
    name: Keep the reports
    sourcePath: .deslop-pr
    artifacts: deslop-report.*
    condition: ALWAYS
  triggers:
  - !PullRequestUpdateTrigger
    branches: {{ default_branch }}
  retryCondition: never
  maxRetries: 3
  retryDelay: 30
  timeout: 900

# Nightly at {{ '%02d:%02d' | format(nightly_hour, nightly_minute) }} (schedule_slot {{ schedule_slot }}): scan the whole default branch with Deslop and file at most three
# issues for the largest new duplicate clusters (Triage: needs-triage). The first
# run only records a baseline. One standing issue, "Deslop nightly", shows the
# figure and the trend. It needs one job secret on main, the access token of an
# account that may write issues: ONEDEV_ISSUES_TOKEN. Set it once, from your own
# shell:
#   {{ vault_command }} <item> | odev secret set ONEDEV_ISSUES_TOKEN
# Last night's clusters live in a job cache. The token is read from the environment,
# never from an argument.{% if deslop_embeddings_endpoint %} Behavioural matches come from Ollama at
# {{ deslop_embeddings_endpoint }}; the scan fails if it cannot be reached.{% endif %}
- name: Deslop nightly
  steps:
  - !CheckoutStep
    name: Checkout
    cloneCredential: !DefaultCredential {}
    withLfs: false
    withSubmodules: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !SetupCacheStep
    name: Last night's clusters
    key: deslop-nightly-state
    loadKeys:
    - deslop-nightly-state
    paths:
    - .deslop-nightly
    uploadStrategy: UPLOAD_IF_CHANGED
    changeDetectionExcludes: ''
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !CommandStep
    name: Scan and file
    runInContainer: true
    image: {{ images['deslop'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        apt-get update -qq && apt-get install -y -qq --no-install-recommends curl jq >/dev/null
        scripts/deslop-pr.sh --full{% if deslop_embeddings_endpoint %} --embeddings {{ deslop_embeddings_endpoint }}{% endif %}
        export ODEV_HOST='@server_url@' ODEV_PROJECT='@project_path@'
        scripts/deslop-issues.sh --forge onedev --report .deslop-pr/deslop-report.json --state .deslop-nightly/state.json --sha "$(git rev-parse HEAD)" --post
    envVars:
    - name: ODEV_TOKEN
      value: '@secret:ONEDEV_ISSUES_TOKEN@'
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !PublishArtifactStep
    name: Keep the reports
    sourcePath: .deslop-pr
    artifacts: deslop-report.*
    condition: ALWAYS
  triggers:
  - !ScheduleTrigger
    cronExpression: 0 {{ nightly_minute }} {{ nightly_hour }} * * ?
  retryCondition: never
  maxRetries: 0
  timeout: 1800

# Nightly at {{ '%02d:%02d' | format(nightly_hour, nightly_minute) }} (the same slot as Deslop nightly): scan the whole history of the default branch
# with TruffleHog for secrets that still work, and file one high-priority issue
# (Priority=Major) for each. A sibling job, so a failure of one scan does not hide
# the other. TruffleHog tests each candidate secret with the credential's own
# provider, so the job needs outbound internet, and it sends the candidate to that
# provider. The issue and the log never hold the secret value. The image is
# pinned by digest; the weekly "Update dependencies" job moves it, as it moves
# every image pin. Uses the same job secret as Deslop nightly: ONEDEV_ISSUES_TOKEN.
- name: Secret scan nightly
  steps:
  - !CheckoutStep
    name: Checkout
    cloneCredential: !DefaultCredential {}
    withLfs: false
    withSubmodules: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !CommandStep
    name: Scan the history
    runInContainer: true
    image: ghcr.io/trufflesecurity/trufflehog:3.99.8@@sha256:674b2f187620a19df77f44cf9a7d77efcc581a5662accef2f2739cbb46ba4a3a
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        scripts/trufflehog-scan.sh
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !CommandStep
    name: File issues
    runInContainer: true
    image: {{ images['deslop'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        apt-get update -qq && apt-get install -y -qq --no-install-recommends curl jq >/dev/null
        export ODEV_HOST='@server_url@' ODEV_PROJECT='@project_path@'
        scripts/trufflehog-issues.sh --forge onedev --findings .trufflehog/findings.jsonl --post
    envVars:
    - name: ODEV_TOKEN
      value: '@secret:ONEDEV_ISSUES_TOKEN@'
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  triggers:
  - !ScheduleTrigger
    cronExpression: 0 {{ nightly_minute }} {{ nightly_hour }} * * ?
  retryCondition: never
  maxRetries: 0
  timeout: 1800

{%- if security_review %}

# The Security review: Strix and the Cloudflare security-audit skill over the source (pins in
# scripts/security.pin), and one confidential issue for each finding. Run it by hand, and on
# day {{ 1 + schedule_slot % 28 }} of each month at {{ '%02d:%02d' | format(nightly_hour, nightly_minute) }} (schedule_slot {{ schedule_slot }}). It runs on {{ default_branch }} only: the job holds an LLM
# key, and code on another branch could carry a prompt injection that leaks it. The real
# guard is the job's three values below: limit each to the default branch (--branches
# {{ default_branch }}), because a branch can edit the step and the scripts. `jobExecutor: security` keeps it
# off the shared executors (the first executor that matches would run it): `security` is a
# Remote Shell Executor on a host that nothing else uses, with Docker for Strix, so the commands
# run on that host, not in a container. Set the job secrets once, from your own shell:
#   {{ vault_command }} <item> | odev secret set SECURITY_LLM_KEY --branches {{ default_branch }}
#   odev secret set SECURITY_LLM_BASE --branches {{ default_branch }}   (https://api.anthropic.com on stdin)
#   {{ vault_command }} <item> | odev secret set ONEDEV_ISSUES_TOKEN --branches {{ default_branch }}   (as for the Deslop nightly)
- name: Security review
  jobExecutor: security
  steps:
  - !CheckoutStep
    name: Checkout
    cloneCredential: !DefaultCredential {}
    withLfs: false
    withSubmodules: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !CommandStep
    name: Scan and file
    runInContainer: false
    interpreter: !ShellInterpreter
      shell: bash
      commands: |
        set -e
        export SECURITY_REF='@branch@' SECURITY_DEFAULT_BRANCH='{{ default_branch }}'
        scripts/security-review.sh --apply --budget {{ security_budget_usd }} --threat-model '{{ threat_model }}'
    envVars:
    - name: SECURITY_LLM_KEY
      value: '@secret:SECURITY_LLM_KEY@'
    - name: SECURITY_LLM_BASE
      value: '@secret:SECURITY_LLM_BASE@'
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !CommandStep
    name: File the issues
    runInContainer: false
    interpreter: !ShellInterpreter
      shell: bash
      commands: |
        set -e
        export ODEV_HOST='@server_url@' ODEV_PROJECT='@project_path@'
        scripts/security-issues.sh --forge onedev --findings security-review-out/findings.json --post
    envVars:
    - name: ODEV_TOKEN
      value: '@secret:ONEDEV_ISSUES_TOKEN@'
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !PublishArtifactStep
    name: Keep the findings
    sourcePath: security-review-out
    artifacts: findings.json
    condition: ALWAYS
  triggers:
  - !ScheduleTrigger
    cronExpression: 0 {{ nightly_minute }} {{ nightly_hour }} {{ 1 + schedule_slot % 28 }} * ?
  retryCondition: never
  maxRetries: 0
  timeout: 7200
{%- endif %}

# Weekly, on {{ ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'][weekly_day] }} at {{ '%02d:%02d' | format(weekly_hour, weekly_minute) }}: refresh dependencies within their ranges and open a PR. Needs two
# job secrets on main, from an account that can push a branch and open a pull
# request: ONEDEV_USER (its login) and ONEDEV_TOKEN (its access token). OneDev
# checks the login with the token. Set them once, from your own shell:
#   odev secret set ONEDEV_USER          (the login on stdin)
#   {{ vault_command }} <item> | odev secret set ONEDEV_TOKEN
# scripts/update-deps.sh opens the PR with curl through the OneDev REST API and keeps
# one PR on chore/deps-weekly. "Merge dependency update" below merges it.{% if split %}
# No image holds every toolchain, so each language refreshes in its own step and
# the last step commits them all and opens the PR.{% endif %}
- name: Update dependencies
  steps:
  - !CheckoutStep
    name: Checkout
    # The default credential cannot push; the last step swaps in the token. Naming
    # the secret here instead would make OneDev reject the whole spec, CI job
    # included, in any repo that has not set it yet.
    cloneCredential: !DefaultCredential {}
    withLfs: false
    withSubmodules: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- if not split %}
  - !CommandStep
    name: Refresh and open a PR
    runInContainer: true
    image: {{ images['python' if 'python' in languages else 'shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
{{- publish_setup() }}
        # skopeo looks up image digests for the refresh's image section. No CI
        # image has it or docker, and Debian packages it. A failed install only
        # skips the image section, which says so.
        apt-get update -qq && apt-get install -y -qq --no-install-recommends skopeo >/dev/null || true
        scripts/update-deps.sh
    envVars:
    - name: ODEV_USER
      value: '@secret:ONEDEV_USER@'
    - name: ODEV_TOKEN
      value: '@secret:ONEDEV_TOKEN@'
{%- if private_index %}
    # uv lock reads the private package index with the read-only login.
    - name: UV_INDEX_{{ private_index_name | upper | replace('-', '_') }}_USERNAME
      value: '@secret:PKG_USER@'
    - name: UV_INDEX_{{ private_index_name | upper | replace('-', '_') }}_PASSWORD
      value: '@secret:PKG_TOKEN@'
{%- endif %}
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- else %}
{%- for l in langs %}
  - !CommandStep
    name: Refresh {{ names[l] }}
    runInContainer: true
    image: {{ images[l] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        scripts/update-deps.sh --refresh-only --only {{ l }}
{%- if l == 'python' %}{{ pyenv() }}{% elif l == 'dotnet' %}{{ nugetenv() }}{% endif %}
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- endfor %}
  - !CommandStep
    name: Refresh image pins
    runInContainer: true
    image: {{ images['shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
        # skopeo looks up image digests for the refresh's image section. No CI
        # image has it or docker, and Debian packages it. A failed install only
        # skips the image section, which says so.
        apt-get update -qq && apt-get install -y -qq --no-install-recommends skopeo >/dev/null || true
        scripts/update-deps.sh --refresh-only --only images --only deslop{% if 'python' in languages or 'dotnet' in languages or 'typescript' in languages %} --only trivy{% endif %}
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !CommandStep
    name: Open a PR
    runInContainer: true
    image: {{ images['shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
{{- publish_setup() }}
        scripts/update-deps.sh --publish-only
    envVars:
    - name: ODEV_USER
      value: '@secret:ONEDEV_USER@'
    - name: ODEV_TOKEN
      value: '@secret:ONEDEV_TOKEN@'
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
{%- endif %}
  triggers:
  - !ScheduleTrigger
    cronExpression: 0 {{ weekly_minute }} {{ weekly_hour }} ? * {{ ['MON','TUE','WED','THU','FRI','SAT','SUN'][weekly_day] }}
  retryCondition: never
  maxRetries: 0
  timeout: 3600

# Daily, three hours after the weekly refresh's hour: merge the open dependency PR when CI passed on its merge preview,
# the preview is built on the branch tip now, and only dependency files changed.
# It runs on {{ default_branch }}, where the job secrets are readable, and uses the secrets
# that "Update dependencies" already names. The merge is a merge commit, and the
# forge checks the merge preview again as it merges. When only {{ default_branch }} moved
# after CI passed, OneDev runs no CI on the new preview: this job starts CI on it
# and a later run merges. The token needs the right to run jobs.
- name: Merge dependency update
  steps:
  - !CheckoutStep
    name: Checkout
    cloneCredential: !DefaultCredential {}
    withLfs: false
    withSubmodules: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  - !CommandStep
    name: Merge when green
    runInContainer: true
    image: {{ images['shell'] }}
    interpreter: !DefaultInterpreter
      commands: |
        set -e
{{- publish_setup() }}
        scripts/update-deps.sh --merge-ready
    envVars:
    - name: ODEV_USER
      value: '@secret:ONEDEV_USER@'
    - name: ODEV_TOKEN
      value: '@secret:ONEDEV_TOKEN@'
    useTTY: false
    condition: ALL_PREVIOUS_STEPS_WERE_SUCCESSFUL
  triggers:
  - !ScheduleTrigger
    cronExpression: 0 {{ weekly_minute }} {{ (weekly_hour + 3) % 24 }} * * ?
  retryCondition: never
  maxRetries: 0
  timeout: 600
