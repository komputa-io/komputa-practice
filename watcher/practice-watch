#!/usr/bin/env bash
# The practice's one watcher: keeps a long agent session going while nobody watches it, for example overnight.
# A session joins by a label on its own hc terminal, so the watcher keeps no files of its own. The user timer that
# watcher/watcherctl installs runs `practice-watch pass --apply` every 5 minutes. Each pass first puts every live
# top-level agent session (claude or codex, with no parent) that carries no watch label on the watch as the lead, as
# `on` does; a session opts out with the label watch=off. A worker (it has a parent) and an old session are left out.
#   practice-watch on [TERMINAL]       watch it (label watch=on) and mark it the lead (lead=1); resets its nudge count
#                                      and handoff request, and unmarks it old. Default: $HC_TERMINAL_ID
#   practice-watch waits [TERMINAL]    it waits for the operator (watch=waits): no nudges until `on` again
#   practice-watch off [TERMINAL]      stop watching it (watch=off, so a pass does not watch it again); it stays the lead
#   practice-watch status              each watched terminal, its state and its nudge count
#   practice-watch handover FILE [TERMINAL] [--apply]
#                                      start a fresh session that continues from handoff FILE, in the same folder,
#                                      space and tab, with the same command, on the watch and the lead (lead=1); the
#                                      old one stays open, off the watch, no longer the lead and marked old
#                                      (watch.old=1). The fresh session gets the old one's program and options, never its
#                                      first message or a resume; it must still run WATCH_START_WAIT seconds (default 5)
#                                      after start, or the old one stays on the watch. Without --apply it prints what it
#                                      would do.
#   practice-watch pass [--apply]      one pass; without --apply it prints what it would do and changes nothing
# For each terminal labelled watch=on, one pass does one of these:
#   - working, or idle or done for less than WATCH_QUIET_MIN minutes (default 30): nothing;
#   - idle or done for longer: a nudge (hc send) that says carry on, take the default on a reversible question, or
#     label itself watch=waits or watch=off ; at most WATCH_MAX_NUDGES nudges (default 12) until `on` again;
#   - blocked on a prompt, out of nudges, or ended: an alert, once for each such state.
# Then each old session (watch.old=1) that has been idle or done for WATCH_CLOSE_H hours (default 3) is closed
# (hc kill and hc rm, which closes its pane), unless it is on the watch or the lead again, or a live terminal it started
# still runs. Its transcript stays on disk, and the sitrep reads its last reply from there.
# Before a nudge, a live session that is not blocked and whose status line shows a context (`ctx 260k`) above
# WATCH_CTX_K thousand tokens (default 250) is asked, once until `on` again, to write a handoff at its next quiet
# point and then run `practice-watch handover`. Each turn rereads the whole context, so a big one costs on every turn.
# hc send waits while a person has a half-typed message in the box, and never types into a blocked prompt. An alert
# is one line on stdout (the journal) and, when WATCH_ALERT_CMD is set, that command with the text as $1.
# When hc does not answer, a pass decides nothing. One flock keeps two passes from overlapping. Every hc call and
# the alert command have a timeout (WATCH_CALL_TIMEOUT seconds, default 30; a send gets 4 times that).
# Exit codes: 0 done (also when another pass holds the lock); 1 an error; 2 misuse.
set -Eeuo pipefail
shopt -s inherit_errexit
trap 'printf "%s: line %d: %s exited %d\n" "${0##*/}" "$LINENO" "$BASH_COMMAND" "$?" >&2' ERR
die() {
  printf 'practice-watch: %s\n' "$1" >&2
  exit "${2:-1}"
}
usage() {
  printf 'usage: practice-watch on|waits|off [TERMINAL] | status | pass [--apply] | handover FILE [TERMINAL] [--apply]\n' >&2
  exit 2
}

quiet_min=${WATCH_QUIET_MIN:-30}
max_nudges=${WATCH_MAX_NUDGES:-12}
call_timeout=${WATCH_CALL_TIMEOUT:-30}
ctx_k=${WATCH_CTX_K:-250}
close_h=${WATCH_CLOSE_H:-3}
# How long a fresh session from a handover must stay up before the old one leaves the watch.
start_wait=${WATCH_START_WAIT:-5}
for n in "$quiet_min" "$max_nudges" "$call_timeout" "$ctx_k" "$close_h"; do
  [[ $n =~ ^[1-9][0-9]*$ ]] || die "WATCH_QUIET_MIN, WATCH_MAX_NUDGES, WATCH_CALL_TIMEOUT, WATCH_CTX_K and WATCH_CLOSE_H take a whole number above 0" 2
done
[[ $start_wait =~ ^[0-9]+$ ]] || die "WATCH_START_WAIT takes a whole number of seconds" 2
command -v jq >/dev/null || die "jq is missing"
command -v hc >/dev/null || die "hc is missing"

hcc=(timeout "$call_timeout" hc)
me="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/practice-watch"
PROMPT_HEAD="Continue the work from the handoff at"
# WATCH_NOW_MS fixes the clock for the tests: a clock step between their read and this one turns 40 idle minutes into 39 or 41 (#123).
now_ms() { if [[ -n ${WATCH_NOW_MS-} ]]; then printf '%s' "$WATCH_NOW_MS"; else date +%s%3N; fi; }

# terminal ARG: the terminal named, or this session's own.
terminal() {
  local t=${1:-${HC_TERMINAL_ID-}}
  [[ -n $t ]] || die "name a terminal; outside an hc terminal there is no default" 2
  printf '%s' "$t"
}

alert() { # alert TEXT
  printf 'practice-watch: ALERT %s\n' "$1"
  if [[ -n ${WATCH_ALERT_CMD-} ]]; then
    timeout "$call_timeout" "$WATCH_ALERT_CMD" "$1" </dev/null || printf 'practice-watch: the alert command failed\n' >&2
  fi
}

# decide INFO: one word for what a pass does with the terminal that `hc get --json` described.
decide() {
  jq -r --argjson now "$(now_ms)" --argjson quiet "$((quiet_min * 60000))" --argjson max "$max_nudges" '
    (.labels["watch.nudges"] // "0" | tonumber? // 0) as $n
    | (.status | if type == "object" then .state else . end // "") as $s
    | if .state != "live" then "alert-ended"
      elif $s == "working" then "none"
      elif $s == "blocked" then "alert-blocked"
      elif ($s == "idle" or $s == "done") | not then "none"
      elif ($now - (.status_ms // $now)) < $quiet then "none"
      elif $n >= $max then "alert-out-of-nudges"
      else "nudge" end' <<<"$1"
}

nudge_text() { # nudge_text ADDRESS MINUTES N
  printf '%s' "[practice-watch] This session has been idle for $2 minutes, and it is on the watch for unattended work (nudge $3 of $max_nudges). If work remains, carry on with the plan: take the default on any reversible question and say which one you took. If only the operator can decide what comes next, say why and run: hc label $1 watch=waits. If the work is finished, run: hc label $1 watch=off"
}

# context_k ADDRESS: the context in thousands of tokens, from the status line on its screen; nothing if none shows.
context_k() {
  "${hcc[@]}" read "$1" 2>/dev/null | grep -oE 'ctx [0-9]+k' | tail -1 | tr -dc '0-9' || true
}

handoff_text() { # handoff_text ADDRESS K
  printf '%s' "[practice-watch] This session's context is ${2}k tokens, past the ${ctx_k}k cap, and every turn rereads all of it. At the next quiet point (no agent report waiting, no merge half done), write a handoff so a fresh session continues from it. Then tell the operator where the handoff is and run: $me handover <the handoff file> $1 --apply . That starts the fresh session and takes this one off the watch. If you cannot write a handoff, say why and run: hc label $1 watch=waits"
}

# Claude Code's options that take a value (claude --help): the value goes with its option. A variadic one keeps one value.
VALUE_OPTS=" --add-dir --agent --agents --allowedTools --append-system-prompt --autocompact --betas --debug-file --disallowedTools --effort --environment --fallback-model --file --input-format --json-schema --max-budget-usd --mcp-config --model -n --name --output-format --permission-mode --permission-prompts --plugin-dir --plugin-url --remote-control-session-name-prefix --setting-sources --settings --system-prompt --system-prompt-snapshot --tools "
# Options that reopen the old conversation; a fresh session leaves them out, with their id.
RESUME_OPTS=" -c --continue -r --resume --session-id --fork-session --from-pr --teleport "

# fresh_command ARGV...: the old session's program and its options, one per line, without any prompt it was started with (a
# launch prompt replayed in a fresh session, or one with a line starting with -, breaks it) and without a resume.
fresh_command() {
  local a name
  printf '%s\n' "$1"
  shift
  while (($# > 0)); do
    a=$1 name=${1%%=*}
    shift
    if [[ $a == -- ]]; then
      break
    elif [[ ! $a =~ ^--?[A-Za-z][A-Za-z0-9-]*(=.*)?$ ]]; then
      continue # not an option (`-x`, `--name`, `--name=value`): the prompt, whatever it starts with
    elif [[ $RESUME_OPTS == *" $name "* ]]; then
      if [[ $a != *=* && $# -gt 0 && ! $1 =~ ^--?[A-Za-z] ]]; then shift; fi
    else
      printf '%s\n' "$a"
      if [[ $a != *=* && $VALUE_OPTS == *" $a "* && $# -gt 0 ]]; then
        printf '%s\n' "$1"
        shift
      fi
    fi
  done
}

handover() { # handover FILE TERMINAL APPLY
  local file=$1 t=$2 apply=$3 info cwd label v new state
  local -a argv old labels=(--label watch=on --label lead=1)
  [[ -f $file ]] || die "no handoff file at $file" 2
  file=$(realpath -- "$file")
  info=$("${hcc[@]}" get "$t" --json) || die "hc get $t did not answer"
  cwd=$(jq -r '.foreground.cwd // .cwd' <<<"$info")
  mapfile -t old < <(jq -r '.foreground.argv // ["claude"] | .[]' <<<"$info")
  mapfile -t argv < <(fresh_command "${old[@]}")
  for label in herdr.space herdr.tab; do
    v=$(jq -r --arg l "$label" '.labels[$l] // ""' <<<"$info")
    [[ -n $v ]] && labels+=(--label "$label=$v")
  done
  argv+=("$PROMPT_HEAD $file. Read it first. This session is on the practice watch.")
  if ((! apply)); then
    printf 'practice-watch: would start in %s: %s\n' "$cwd" "${argv[*]}"
    printf 'practice-watch: would take %s off the watch; to apply: practice-watch handover %s %s --apply\n' "$t" "$file" "$t"
    return 0
  fi
  new=$("${hcc[@]}" run --json --bg --no-parent --cwd "$cwd" "${labels[@]}" -- "${argv[@]}" | jq -r '.address // ""') || new=
  [[ -n $new ]] || die "hc run did not start the fresh session; $t stays on the watch"
  # A session that dies at start (a bad option, say) must not leave nobody on the watch.
  sleep "$start_wait"
  state=$("${hcc[@]}" get "$new" --json | jq -r '.state // ""') || state=
  if [[ $state != live ]]; then
    printf 'practice-watch: %s said: %s\n' "$new" "$("${hcc[@]}" read "$new" 2>/dev/null | tail -n 3 | tr '\n' ' ')" >&2
    die "the fresh session $new did not stay up (state ${state:-unknown}); $t stays on the watch"
  fi
  "${hcc[@]}" label "$t" watch= watch.nudges= watch.alerted= watch.handoff= lead= watch.old=1 >/dev/null
  printf 'practice-watch: started %s from %s; %s is off the watch and no longer the lead, and closes after %s idle hours\n' "$new" "$file" "$t" "$close_h"
}

# close_old APPLY: close each old session that has sat idle or done for close_h hours, unless it is needed again.
close_old() {
  local apply=$1 old live addr info parents="" mins
  old=$("${hcc[@]}" ls --label watch.old=1 --json) || return 0
  [[ -n $(jq -r '.terminals[].address' <<<"$old") ]] || return 0
  # A worker ends with its parent, so a parent with a live worker stays. When any terminal cannot be read, none closes.
  live=$("${hcc[@]}" ls --json) || return 0
  for addr in $(jq -r '.terminals[].address' <<<"$live"); do
    info=$("${hcc[@]}" get "$addr" --json) || {
      printf 'practice-watch: hc get %s did not answer; no old session closes this pass\n' "$addr" >&2
      return 0
    }
    parents+=" $(jq -r '.parent // ""' <<<"$info") "
  done
  for addr in $(jq -r '.terminals[].address' <<<"$old"); do
    info=$("${hcc[@]}" get "$addr" --json) || continue
    mins=$(jq -r --argjson now "$(now_ms)" '
      (.status | if type == "object" then .state else . end // "") as $s
      | if .state == "live" and ($s == "idle" or $s == "done") and (.labels.watch // "") == "" and (.labels.lead // "") == ""
        then ($now - (.status_ms // $now)) / 60000 | floor else -1 end' <<<"$info")
    ((mins >= close_h * 60)) || continue
    if [[ $parents == *" $addr "* ]]; then
      printf 'practice-watch: %s: old and idle, but a terminal it started still runs; left open\n' "$addr"
    elif ((! apply)); then
      printf 'practice-watch: %s: would close (old, idle %s min)\n' "$addr" "$mins"
    elif "${hcc[@]}" kill "$addr" >/dev/null && "${hcc[@]}" rm "$addr" >/dev/null; then
      printf 'practice-watch: %s: closed (old, idle %s min)\n' "$addr" "$mins"
    else
      printf 'practice-watch: %s: did not close; the next pass tries again\n' "$addr" >&2
    fi
  done
}

# adopt APPLY: put each live top-level agent session with no watch label on the watch as the lead, as `on` does. A session
# labelled watch=off (or waits) keeps its label; an old one (watch.old=1) is closing; a worker ends with its parent.
adopt() {
  local apply=$1 live addr info
  live=$("${hcc[@]}" ls --json) || return 0
  for addr in $(jq -r '.terminals[].address' <<<"$live"); do
    info=$("${hcc[@]}" get "$addr" --json) || continue
    jq -e '.state == "live" and (.parent // "") == "" and (.labels.watch // "") == "" and (.labels["watch.old"] // "") == ""
      and ((.foreground.argv[0] // "") | split("/") | last | IN("claude", "codex"))' <<<"$info" >/dev/null || continue
    if ((! apply)); then
      printf 'practice-watch: %s: would watch it as the lead (a top-level agent session with no watch label)\n' "$addr"
    elif "${hcc[@]}" label "$addr" watch=on watch.nudges=0 watch.alerted= watch.handoff= lead=1 >/dev/null; then
      printf 'practice-watch: %s: now watched and the lead (to opt out: hc label %s watch=off)\n' "$addr" "$addr"
    else
      printf 'practice-watch: %s: the watch label was not set; the next pass tries again\n' "$addr" >&2
    fi
  done
}

pass() {
  local apply=$1 list addr info action n mins key text k
  list=$("${hcc[@]}" ls --all --label watch=on --json) || {
    printf 'practice-watch: hc did not answer; nothing decided this pass\n' >&2
    return 0
  }
  for addr in $(jq -r '.terminals[].address' <<<"$list"); do
    info=$("${hcc[@]}" get "$addr" --json) || {
      printf 'practice-watch: %s: hc get did not answer; skipped\n' "$addr" >&2
      continue
    }
    action=$(decide "$info")
    n=$(jq -r '.labels["watch.nudges"] // "0" | tonumber? // 0' <<<"$info")
    # A big context: ask once for a handoff. It takes the place of this pass's nudge, since it wakes the session too.
    if [[ $action == none || $action == nudge ]] && [[ -z $(jq -r '.labels["watch.handoff"] // ""' <<<"$info") ]]; then
      k=$(context_k "$addr")
      if [[ -n $k ]] && ((k > ctx_k)); then
        text=$(handoff_text "$addr" "$k")
        if ((! apply)); then
          printf 'practice-watch: %s: would ask for a handoff (context %sk, cap %sk)\n' "$addr" "$k" "$ctx_k"
        elif timeout "$((call_timeout * 4))" hc send "$addr" "$text" >/dev/null; then
          "${hcc[@]}" label "$addr" "watch.handoff=${k}k" >/dev/null
          printf 'practice-watch: %s: asked for a handoff (context %sk, cap %sk)\n' "$addr" "$k" "$ctx_k"
        else
          printf 'practice-watch: %s: the handoff request was not sent; the next pass tries again\n' "$addr" >&2
        fi
        continue
      fi
    fi
    case $action in
      none) printf 'practice-watch: %s: nothing to do\n' "$addr" ;;
      nudge)
        mins=$((($(now_ms) - $(jq -r '.status_ms' <<<"$info")) / 60000))
        if ((! apply)); then
          printf 'practice-watch: %s: would nudge (idle %s min, nudge %s of %s)\n' "$addr" "$mins" "$((n + 1))" "$max_nudges"
          continue
        fi
        text=$(nudge_text "$addr" "$mins" "$((n + 1))")
        if timeout "$((call_timeout * 4))" hc send "$addr" "$text" >/dev/null; then
          "${hcc[@]}" label "$addr" "watch.nudges=$((n + 1))" >/dev/null
          printf 'practice-watch: %s: nudged (idle %s min, nudge %s of %s)\n' "$addr" "$mins" "$((n + 1))" "$max_nudges"
        else
          printf 'practice-watch: %s: the nudge was not sent; the next pass tries again\n' "$addr" >&2
        fi
        ;;
      alert-*)
        # Once for each state: the key holds the state and the time it began.
        key="${action#alert-}@$(jq -r '.status_ms // .finished_ms // 0' <<<"$info")"
        if [[ $(jq -r '.labels["watch.alerted"] // ""' <<<"$info") == "$key" ]]; then
          printf 'practice-watch: %s: %s, already told\n' "$addr" "${action#alert-}"
        elif ((! apply)); then
          printf 'practice-watch: %s: would alert: %s\n' "$addr" "${action#alert-}"
        else
          alert "$addr ($(jq -r '.cwd // "?"' <<<"$info")): ${action#alert-}"
          "${hcc[@]}" label "$addr" "watch.alerted=$key" >/dev/null || true
        fi
        ;;
    esac
  done
}

cmd=${1-}
(($# > 0)) && shift
case $cmd in
  on)
    (($# <= 1)) || usage
    t=$(terminal "${1-}")
    "${hcc[@]}" label "$t" watch=on watch.nudges=0 watch.alerted= watch.handoff= lead=1 watch.old= >/dev/null
    printf 'practice-watch: watching %s\n' "$t"
    ;;
  waits)
    (($# <= 1)) || usage
    t=$(terminal "${1-}")
    "${hcc[@]}" label "$t" watch=waits >/dev/null
    printf 'practice-watch: %s waits for the operator; no nudges until practice-watch on\n' "$t"
    ;;
  off)
    (($# <= 1)) || usage
    t=$(terminal "${1-}")
    "${hcc[@]}" label "$t" watch=off watch.nudges= watch.alerted= watch.handoff= >/dev/null
    printf 'practice-watch: no longer watching %s\n' "$t"
    ;;
  status)
    (($# == 0)) || usage
    for v in on waits; do
      "${hcc[@]}" ls --all --label "watch=$v" --json | jq -r --arg v "$v" '.terminals[] | "\(.address)\twatch=\($v)\t\(.state)\t\(.status // "")\t\(.cwd // "")"'
    done
    ;;
  handover)
    apply=0 args=()
    for a in "$@"; do
      if [[ $a == --apply ]]; then apply=1; else args+=("$a"); fi
    done
    ((${#args[@]} >= 1 && ${#args[@]} <= 2)) || usage
    handover "${args[0]}" "$(terminal "${args[1]-}")" "$apply"
    ;;
  pass)
    apply=0
    case ${1-} in
      "") ;;
      --apply) apply=1 ;;
      *) usage ;;
    esac
    (($# <= 1)) || usage
    lock="${XDG_RUNTIME_DIR:-/tmp}/practice-watch.lock"
    exec 9>"$lock"
    flock -n 9 || {
      printf 'practice-watch: another pass holds %s\n' "$lock"
      exit 0
    }
    adopt "$apply"
    pass "$apply"
    close_old "$apply"
    ((apply)) || printf 'practice-watch: dry run; to apply: practice-watch pass --apply\n'
    ;;
  *) usage ;;
esac
